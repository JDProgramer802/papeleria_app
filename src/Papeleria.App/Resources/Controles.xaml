<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:controls="clr-namespace:Papeleria.App.Controls">

    <!--
        Plantilla del envoltorio de formularios. Reparte el diálogo en tres zonas
        fijas —cabecera, campos desplazables y pie— para que todos los CRUD del
        sistema tengan el mismo aspecto y comportamiento.
    -->
    <Style TargetType="{x:Type controls:PanelFormulario}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PanelFormulario}">
                    <Grid Margin="26,22,26,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ══ Cabecera ═══════════════════════════════════════ -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                                <materialDesign:PackIcon Kind="{TemplateBinding Icono}"
                                                         Width="24" Height="24"
                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Titulo}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" />

                                <!-- TemplateBinding no admite convertidores, de ahí el
                                     enlace explícito al padre de la plantilla. -->
                                <TextBlock Text="{TemplateBinding Subtitulo}"
                                           Style="{StaticResource TextoTenue}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxWidth="620"
                                           HorizontalAlignment="Left"
                                           Visibility="{Binding Subtitulo,
                                                        RelativeSource={RelativeSource TemplatedParent},
                                                        Converter={StaticResource TextoAVisible}}" />
                            </StackPanel>
                        </StackPanel>

                        <Separator Grid.Row="1" Style="{StaticResource MaterialDesignSeparator}"
                                   Margin="0,16,0,16" />

                        <!-- ══ Campos ═════════════════════════════════════════ -->
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,8,0"
                                          MaxHeight="{TemplateBinding AltoMaximoContenido}">
                                <ContentPresenter />
                            </ScrollViewer>

                            <!-- Velo mientras se guarda: evita dobles envíos y deja
                                 claro que la operación está en curso. -->
                            <Border Background="{DynamicResource MaterialDesignPaper}"
                                    Opacity="0.72"
                                    Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}" />

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             IsIndeterminate="True" Width="38" Height="38" />
                                <TextBlock Text="Guardando…" Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource TextoTenue}" />
                            </StackPanel>
                        </Grid>

                        <!-- ══ Aviso de error ═════════════════════════════════ -->
                        <Border Grid.Row="3"
                                Background="{StaticResource BrochaErrorSuave}"
                                CornerRadius="8" Padding="13,10" Margin="0,16,0,0"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                         Foreground="{StaticResource BrochaError}"
                                                         VerticalAlignment="Top"
                                                         Margin="0,1,10,0" />
                                <TextBlock Text="{Binding MensajeError}"
                                           Foreground="{StaticResource BrochaError}"
                                           TextWrapping="Wrap"
                                           FontSize="12.5" />
                            </StackPanel>
                        </Border>

                        <!-- ══ Pie de acciones ════════════════════════════════ -->
                        <Grid Grid.Row="4" Margin="0,18,0,0">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextoTenue}"
                                       FontSize="11.5"
                                       Visibility="{Binding MostrarLeyendaObligatorios,
                                                    RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource BoolAVisible}}">
                                <Run Text="*" Foreground="{StaticResource BrochaError}" FontWeight="Bold" />
                                <Run Text="Campos obligatorios" />
                            </TextBlock>

                            <ContentPresenter ContentSource="Pie" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tarjeta de indicador del panel principal. La cifra va primero y con el mayor
        peso tipográfico: es el dato que se consulta de un vistazo. La etiqueta queda
        debajo y el icono actúa como acento de color, sin robar altura a la tarjeta.
    -->
    <Style TargetType="{x:Type controls:TarjetaMetrica}">
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TarjetaMetrica}">
                    <materialDesign:Card x:Name="Tarjeta"
                                         Style="{StaticResource TarjetaInteractiva}"
                                         Padding="16,14"
                                         Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- La cifra manda: ocupa la primera línea de lectura. -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Valor, RelativeSource={RelativeSource TemplatedParent}}"
                                       Style="{StaticResource ValorDestacado}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Etiqueta, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       Opacity="0.85"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,8,0" />

                            <!-- Acento de color; se alinea con la cifra, no con la etiqueta. -->
                            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                    Width="40" Height="40"
                                    CornerRadius="11"
                                    VerticalAlignment="Top"
                                    Background="{Binding FondoIcono, RelativeSource={RelativeSource TemplatedParent}}">
                                <materialDesign:PackIcon
                                    Kind="{Binding Icono, RelativeSource={RelativeSource TemplatedParent}}"
                                    Width="21" Height="21"
                                    Foreground="{Binding ColorIcono, RelativeSource={RelativeSource TemplatedParent}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Nota al pie: o el texto simple, o el bloque de variación. -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Nota, RelativeSource={RelativeSource TemplatedParent}}"
                                       Style="{StaticResource TextoTenue}"
                                       FontSize="11.5"
                                       Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <ContentPresenter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                              ContentSource="Pie"
                                              Margin="0,8,0,0" />
                        </Grid>
                    </materialDesign:Card>

                    <ControlTemplate.Triggers>
                        <!-- Un dato que exige actuar se marca con un borde, no con otro color de fondo. -->
                        <Trigger Property="EsAlerta" Value="True">
                            <Setter TargetName="Tarjeta" Property="BorderBrush"
                                    Value="{StaticResource BrochaAdvertencia}" />
                            <Setter TargetName="Tarjeta" Property="BorderThickness" Value="1,1,1,3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
