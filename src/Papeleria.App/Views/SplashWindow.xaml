<Window x:Class="Papeleria.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PapelSoft"
        Height="380" Width="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Papeleria;component/Resources/Images/app.ico"
        TextElement.Foreground="White"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <!-- Mismo filo que la ventana de acceso: las dos van sin marco del sistema. -->
    <Border CornerRadius="14" Margin="16"
            BorderThickness="1" BorderBrush="#38FFFFFF"
            ClipToBounds="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#041D53" Offset="0" />
                <GradientStop Color="#0B3F9E" Offset="0.45" />
                <GradientStop Color="#0379EE" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <!-- El recorte se calcula en el código: ClipToBounds recorta al rectángulo,
             no al radio, y los círculos de fondo se salían por las esquinas. -->
        <Grid x:Name="Recorte" SizeChanged="AjustarRecorte">
            <!-- Círculos decorativos de fondo -->
            <Ellipse Width="260" Height="260" Fill="#14FFFFFF"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-90,-70,0" />
            <Ellipse Width="180" Height="180" Fill="#0FFFFFFF"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-60,0,0,-60" />

            <Grid Margin="44,36,44,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logotipo y nombre -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border x:Name="ContenedorLogo"
                            Width="76" Height="76"
                            CornerRadius="18"
                            Background="White"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="EscalaLogo" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Image Source="pack://application:,,,/Papeleria;component/Resources/Images/marca.png"
                               Width="52" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PapelSoft"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="Software de papelería"
                                   FontSize="14"
                                   Opacity="0.85"
                                   Foreground="White"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Módulos incluidos -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1FFFFFFF" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="Padding" Value="11,5" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="Opacity" Value="0.92" />
                        </Style>
                    </WrapPanel.Resources>
                    <Border><TextBlock Text="Inventario" /></Border>
                    <Border><TextBlock Text="Punto de venta" /></Border>
                    <Border><TextBlock Text="Compras" /></Border>
                    <Border><TextBlock Text="Caja" /></Border>
                    <Border><TextBlock Text="Kardex" /></Border>
                    <Border><TextBlock Text="Clientes" /></Border>
                    <Border><TextBlock Text="Proveedores" /></Border>
                    <Border><TextBlock Text="Reportes" /></Border>
                </WrapPanel>

                <!-- Progreso -->
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="TextoEstado"
                               Text="Iniciando…"
                               FontSize="12.5"
                               Foreground="White"
                               Opacity="0.9"
                               Margin="0,0,0,8" />

                    <ProgressBar x:Name="BarraProgreso"
                                 Height="5"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="White"
                                 Background="#33FFFFFF"
                                 BorderThickness="0" />

                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="TextoVersion"
                                   Text="Versión 1.0.0"
                                   FontSize="11"
                                   Foreground="White"
                                   Opacity="0.75"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="© 2026 · Funciona sin conexión"
                                   FontSize="11"
                                   Foreground="White"
                                   Opacity="0.75"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Aparición suave de la ventana -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45" />
                    <!-- Latido continuo del logotipo mientras se prepara el sistema -->
                    <DoubleAnimation Storyboard.TargetName="EscalaLogo"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.92" To="1.05" Duration="0:0:1.1"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EscalaLogo"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.92" To="1.05" Duration="0:0:1.1"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
