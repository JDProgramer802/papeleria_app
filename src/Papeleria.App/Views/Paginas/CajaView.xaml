<UserControl x:Class="Papeleria.App.Views.Paginas.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:CajaVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1340">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding ImprimirArqueoCommand}"
                        ToolTip="Generar el arqueo en PDF">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PrinterOutline" VerticalAlignment="Center" />
                        <TextBlock Text="Arqueo PDF" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonPrincipal}"
                        Command="{Binding AbrirCajaCommand}"
                        Visibility="{Binding HayCajaAbierta, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}"
                        ToolTip="Abrir un turno de caja con su base inicial">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockOpenVariantOutline" VerticalAlignment="Center" />
                        <TextBlock Text="ABRIR CAJA" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <!-- ══ Turno abierto ═══════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="18" Margin="0,0,0,14"
                             Visibility="{Binding HayCajaAbierta, Converter={StaticResource BoolAVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5"
                                Background="{StaticResource BrochaExito}" VerticalAlignment="Center" />
                        <TextBlock Text="Turno de caja abierto" FontWeight="Bold" FontSize="15"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource TextoTenue}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="12.5">
                            <Run Text="desde" />
                            <Run Text="{Binding SesionAbierta.FechaApertura, Converter={StaticResource Fecha}, ConverterParameter=Hora, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Cifras del arqueo en curso -->
                    <WrapPanel Margin="0,16,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="0,0,32,10" />
                                <Setter Property="MinWidth" Value="130" />
                            </Style>
                        </WrapPanel.Resources>

                        <StackPanel>
                            <TextBlock Text="Base inicial" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock Text="{Binding Arqueo.MontoInicial, Converter={StaticResource Moneda}}"
                                       FontWeight="SemiBold" FontSize="15" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Ventas en efectivo" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock Text="{Binding Arqueo.VentasEfectivo, Converter={StaticResource Moneda}}"
                                       FontWeight="SemiBold" FontSize="15" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Otros medios" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock Text="{Binding Arqueo.VentasOtrosMedios, Converter={StaticResource Moneda}}"
                                       FontWeight="SemiBold" FontSize="15" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Ingresos" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock Text="{Binding Arqueo.Ingresos, Converter={StaticResource Moneda}}"
                                       FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource BrochaExito}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Egresos" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock Text="{Binding Arqueo.Egresos, Converter={StaticResource Moneda}}"
                                       FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource BrochaError}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Arqueo.HayDevoluciones,
                                                 Converter={StaticResource BoolAVisible}}">
                            <TextBlock Text="Devoluciones" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock Text="{Binding Arqueo.Devoluciones, Converter={StaticResource Moneda}}"
                                       FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource BrochaError}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Ventas del turno" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock Text="{Binding Arqueo.CantidadVentas}"
                                       FontWeight="SemiBold" FontSize="15" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border CornerRadius="10" Padding="18,12" Margin="0,0,0,10"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}">
                        <StackPanel>
                            <TextBlock Text="EFECTIVO ESPERADO" Foreground="White" Opacity="0.85"
                                       FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Arqueo.MontoEsperado, Converter={StaticResource Moneda}}"
                                       Foreground="White" FontSize="26" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                Command="{Binding RegistrarIngresoCommand}"
                                ToolTip="Registrar dinero que entra a la caja">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashPlus" VerticalAlignment="Center"
                                                         Foreground="{StaticResource BrochaExito}" />
                                <TextBlock Text="Ingreso" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                Command="{Binding RegistrarEgresoCommand}"
                                ToolTip="Registrar dinero que sale de la caja">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMinus" VerticalAlignment="Center"
                                                         Foreground="{StaticResource BrochaError}" />
                                <TextBlock Text="Egreso" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource BotonPeligro}"
                                Command="{Binding CerrarCajaCommand}"
                                ToolTip="Contar el efectivo y cerrar el turno">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LockCheckOutline" VerticalAlignment="Center" />
                                <TextBlock Text="CERRAR CAJA" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Caja cerrada -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="24" Margin="0,0,0,14"
                             Visibility="{Binding HayCajaAbierta, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="LockOutline" Width="34" Height="34"
                                         VerticalAlignment="Center" Opacity="0.4" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="No hay ningún turno de caja abierto"
                               FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Abra la caja indicando la base inicial para poder registrar ventas."
                               Style="{StaticResource TextoTenue}" FontSize="12.5" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- ══ Historial y movimientos ═════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <TextBlock Text="Historial de turnos" Style="{StaticResource TituloSeccion}"
                                   Margin="0" VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <DatePicker Width="130" Height="34" SelectedDate="{Binding Desde}"
                                        materialDesign:HintAssist.Hint="Desde"
                                        VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker Width="130" Height="34" SelectedDate="{Binding Hasta}"
                                        materialDesign:HintAssist.Hint="Hasta"
                                        VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" Style="{StaticResource GrillaDatos}"
                              ItemsSource="{Binding Historial}"
                              SelectedItem="{Binding SesionSeleccionada}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.º" Binding="{Binding Id}" Width="55" />
                            <DataGridTextColumn Header="Apertura" Width="145"
                                                Binding="{Binding FechaApertura, Converter={StaticResource Fecha}, ConverterParameter=Hora}" />
                            <DataGridTextColumn Header="Cierre" Width="145"
                                                Binding="{Binding FechaCierre, Converter={StaticResource Fecha}, ConverterParameter=Hora}" />
                            <DataGridTextColumn Header="Responsable" Binding="{Binding UsuarioApertura}" Width="*" />

                            <DataGridTextColumn Header="Ventas" Binding="{Binding CantidadVentas}" Width="70"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Esperado" Width="110"
                                                Binding="{Binding MontoEsperado, Converter={StaticResource Moneda}}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Contado" Width="110"
                                                Binding="{Binding MontoReal, Converter={StaticResource Moneda}}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTemplateColumn Header="Diferencia" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Diferencia, Converter={StaticResource Moneda}}"
                                                       HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Foreground="{Binding Diferencia, Converter={StaticResource VariacionABrocha}}" />
                                            <TextBlock Text="{Binding DiferenciaTexto}"
                                                       Style="{StaticResource TextoTenue}" FontSize="10.5"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Estado" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Distintivo}">
                                                    <Setter Property="Background" Value="#9E9E9E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaAbierta}" Value="True">
                                                            <Setter Property="Background" Value="#43A047" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoTexto}"
                                                       Style="{StaticResource TextoDistintivo}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Movimientos del turno"
                               Style="{StaticResource TituloSeccion}" Margin="16,14,16,10" />

                    <Grid Grid.Row="1">
                        <DataGrid Style="{StaticResource GrillaDatos}"
                                  ItemsSource="{Binding Movimientos}" RowHeight="46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hora" Width="80"
                                                    Binding="{Binding Fecha, Converter={StaticResource Fecha}, ConverterParameter=SoloHora}" />

                                <DataGridTemplateColumn Header="Concepto" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Concepto}"
                                                           TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                                <TextBlock Text="{Binding TipoTexto}"
                                                           Style="{StaticResource TextoTenue}" FontSize="10.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Monto" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Monto, Converter={StaticResource Moneda}}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Signo, Converter={StaticResource VariacionABrocha}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Movimientos.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                            <materialDesign:PackIcon Kind="CashRemove" Width="44" Height="44"
                                                     Opacity="0.25" HorizontalAlignment="Center" />
                            <TextBlock Text="Seleccione un turno para ver sus movimientos"
                                       Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
