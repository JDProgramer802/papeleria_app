<UserControl x:Class="Papeleria.App.Views.Paginas.CarteraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:CarteraVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1360">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Encabezado ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotonPrincipal}" Margin="0,0,8,0"
                        Command="{Binding AbonarCommand}"
                        IsEnabled="{Binding HaySeleccion}"
                        Visibility="{Binding PuedeAbonar, Converter={StaticResource BoolAVisible}}"
                        ToolTip="Recibir un pago del cliente seleccionado">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashCheck" VerticalAlignment="Center" />
                        <TextBlock Text="REGISTRAR ABONO" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonIconoAccion}"
                        Command="{Binding ActualizarCommand}" ToolTip="Actualizar la cartera">
                    <materialDesign:PackIcon Kind="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ Resumen de la cartera ═══════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-14,0">
            <controls:TarjetaMetrica
                Icono="CashMultiple"
                FondoIcono="#E3F2FD"
                ColorIcono="#1565C0"
                Etiqueta="Total por cobrar"
                Valor="{Binding Resumen.SaldoTotal, Converter={StaticResource Moneda}}">
                <controls:TarjetaMetrica.Pie>
                    <TextBlock Style="{StaticResource TextoTenue}" FontSize="11.5">
                        <Run Text="{Binding Resumen.ClientesConDeuda, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="cliente(s) con deuda" />
                    </TextBlock>
                </controls:TarjetaMetrica.Pie>
            </controls:TarjetaMetrica>

            <controls:TarjetaMetrica
                Icono="ClockOutline"
                FondoIcono="#FFF8E1"
                ColorIcono="#F57F17"
                Etiqueta="Hasta 30 días"
                Valor="{Binding Resumen.VencidoA30, Converter={StaticResource Moneda}}"
                Nota="deuda reciente" />

            <controls:TarjetaMetrica
                Icono="AlertOutline"
                FondoIcono="#FFF3E0"
                ColorIcono="#EF6C00"
                Etiqueta="De 31 a 60 días"
                Valor="{Binding Resumen.VencidoA60, Converter={StaticResource Moneda}}"
                Nota="conviene recordar el pago" />

            <controls:TarjetaMetrica
                Icono="AlertCircleOutline"
                FondoIcono="#FFEBEE"
                ColorIcono="#C62828"
                Etiqueta="Más de 60 días"
                Valor="{Binding Resumen.VencidoMas60, Converter={StaticResource Moneda}}"
                Nota="cobro urgente"
                EsAlerta="{Binding Resumen.VencidoMas60, Converter={StaticResource MayorQueCeroABool}}" />
        </UniformGrid>

        <!-- ══ Filtros ═════════════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource CampoBusqueda}"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         materialDesign:HintAssist.Hint="Buscar por nombre, documento o teléfono"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                <ComboBox Grid.Column="2" Style="{StaticResource FiltroSeleccion}"
                          materialDesign:HintAssist.Hint="Antigüedad"
                          ItemsSource="{Binding OpcionesMora}"
                          SelectedValue="{Binding MoraSeleccionada}"
                          SelectedValuePath="Key" DisplayMemberPath="Value" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Solo con saldo" IsChecked="{Binding SoloConSaldo}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Ocultar a los clientes que ya pagaron todo" />

                    <Button Style="{StaticResource BotonIconoAccion}"
                            Command="{Binding LimpiarFiltrosCommand}"
                            ToolTip="Limpiar todos los filtros">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ══ Deudores y estado de cuenta ═════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- La fila crece porque el cliente lleva documento y teléfono debajo. -->
                    <DataGrid Grid.Row="0" Style="{StaticResource GrillaDatos}"
                              RowHeight="54"
                              ItemsSource="{Binding Deudores}"
                              SelectedItem="{Binding DeudorSeleccionado}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Cliente" Width="*" SortMemberPath="Nombre">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource TextoTenue}" FontSize="11">
                                                <Run Text="{Binding NumeroDocumento, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Telefono, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Facturas" Width="85"
                                                Binding="{Binding FacturasPendientes}"
                                                ElementStyle="{StaticResource CeldaNumerica}"
                                                HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTemplateColumn Header="Antigüedad" Width="120" SortMemberPath="DiasDeMora">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- El color avisa a quién hay que llamar primero -->
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DiasDeMora, Converter={StaticResource MayorQueCeroABool}}" Value="True">
                                                            <Setter Property="Background" Value="#FFF8E1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11.5">
                                                <Run Text="{Binding DiasDeMora, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="días" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Cupo" Width="110"
                                                Binding="{Binding LimiteCredito, Converter={StaticResource Moneda}}"
                                                ElementStyle="{StaticResource CeldaNumerica}"
                                                HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTemplateColumn Header="Debe" Width="130" SortMemberPath="Saldo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Saldo, Converter={StaticResource Moneda}}"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="Bold" FontSize="13.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SuperaCupo}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource BrochaError}" />
                                                            <Setter Property="ToolTip"
                                                                    Value="La deuda supera el cupo autorizado" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vacío -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Deudores.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                        <materialDesign:PackIcon Kind="CheckDecagramOutline"
                                                 Width="52" Height="52" Opacity="0.25"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Nadie tiene deudas pendientes"
                                   Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <controls:PaginadorView Grid.Row="1" DataContext="{Binding Paginador}" />
                </Grid>
            </materialDesign:Card>

            <!-- ══ Estado de cuenta del cliente ════════════════════════════ -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <!-- Sin selección -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible},
                                             ConverterParameter=Invertir}">
                        <materialDesign:PackIcon Kind="AccountCashOutline"
                                                 Width="44" Height="44" Opacity="0.25"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Seleccione un cliente para ver su estado de cuenta"
                                   Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible}}">
                        <StackPanel Margin="18">
                            <TextBlock Text="{Binding DeudorSeleccionado.Nombre}"
                                       Style="{StaticResource TituloSeccion}"
                                       TextWrapping="Wrap" Margin="0,0,0,2" />

                            <Grid Margin="0,6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Debe" Style="{StaticResource EtiquetaCampo}" />
                                    <TextBlock Text="{Binding EstadoCuenta.Resumen.Saldo, Converter={StaticResource Moneda}}"
                                               FontWeight="Bold" FontSize="19"
                                               Foreground="{StaticResource BrochaError}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Cupo disponible" Style="{StaticResource EtiquetaCampo}" />
                                    <TextBlock Text="{Binding EstadoCuenta.Resumen.CupoDisponible, Converter={StaticResource Moneda}}"
                                               FontWeight="Bold" FontSize="19"
                                               Foreground="{StaticResource BrochaExito}" />
                                </StackPanel>
                            </Grid>

                            <!-- Facturas fiadas con lo que falta de cada una -->
                            <TextBlock Text="Facturas a crédito" Style="{StaticResource EtiquetaCampo}"
                                       Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Facturas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,7" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding NumeroFactura}"
                                                               FontWeight="SemiBold" FontSize="12.5" />
                                                    <TextBlock Style="{StaticResource TextoTenue}" FontSize="11">
                                                        <Run Text="{Binding Fecha, Converter={StaticResource Fecha}, Mode=OneWay}" />
                                                        <Run Text=" · hace " />
                                                        <Run Text="{Binding Dias, Mode=OneWay}" />
                                                        <Run Text="días" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Pendiente, Converter={StaticResource Moneda}}"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="SemiBold" FontSize="12.5" />
                                                    <TextBlock Style="{StaticResource TextoTenue}" FontSize="10.5"
                                                               HorizontalAlignment="Right">
                                                        <Run Text="de" />
                                                        <Run Text="{Binding Total, Converter={StaticResource Moneda}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Abonos recibidos -->
                            <TextBlock Text="Abonos recibidos" Style="{StaticResource EtiquetaCampo}"
                                       Margin="0,18,0,6" />

                            <TextBlock Text="Todavía no ha abonado nada."
                                       Style="{StaticResource TextoTenue}" FontSize="11.5"
                                       Visibility="{Binding Abonos.Count, Converter={StaticResource ColeccionVaciaAVisible}}" />

                            <ItemsControl ItemsSource="{Binding Abonos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,7" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Fecha, Converter={StaticResource Fecha}}"
                                                               FontSize="12.5" />
                                                    <TextBlock Text="{Binding MetodoPago, Converter={StaticResource EnumADescripcion}}"
                                                               Style="{StaticResource TextoTenue}" FontSize="11" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Monto, Converter={StaticResource Moneda}}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{StaticResource BrochaExito}" />

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource BotonIconoAccion}"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.AnularAbonoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{StaticResource BrochaError}"
                                                        ToolTip="Anular este abono"
                                                        Visibility="{Binding DataContext.PuedeAnularAbono,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                                     Converter={StaticResource BoolAVisible}}">
                                                    <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                                             Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
