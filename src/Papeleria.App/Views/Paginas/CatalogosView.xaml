<UserControl x:Class="Papeleria.App.Views.Paginas.CatalogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:CatalogosVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1400">

    <UserControl.Resources>
        <!--
            Fila de un catálogo. Las tres listas comparten forma: nombre arriba, un
            segundo dato debajo y las acciones a la derecha, que sólo se ven al pasar
            el ratón o al seleccionar para no saturar la lista de iconos.
        -->
        <Style x:Key="FilaCatalogo" TargetType="ListBoxItem"
               BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- La misma raya de las tablas: sin ella la lista se lee como texto suelto. -->
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="AccionesFila" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <!--
            Los tres catálogos a la vez en lugar de pestañas: son listas cortas que se
            consultan juntas al dar de alta un producto, y así se evita ir y volver
            entre solapas para comparar lo que existe.
        -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══ Categorías ══════════════════════════════════════════════ -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,10,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#E3F2FD">
                                <materialDesign:PackIcon Kind="ShapeOutline" Width="19" Height="19"
                                                         Foreground="#1565C0"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Categorías" Style="{StaticResource TituloSeccion}"
                                       VerticalAlignment="Center" Margin="10,0,8,0" />

                            <Border Style="{StaticResource ContadorLista}">
                                <TextBlock Text="{Binding Categorias.Count}" FontSize="11"
                                           FontWeight="SemiBold" Opacity="0.75" />
                            </Border>
                        </StackPanel>

                        <Button Style="{StaticResource BotonIconoAccion}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding NuevaCategoriaCommand}"
                                Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}"
                                ToolTip="Crear una categoría">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Margin="16,0,16,10"
                             Style="{StaticResource CampoBusqueda}"
                             Text="{Binding BusquedaCategorias, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             materialDesign:HintAssist.Hint="Buscar categoría"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                    <ListBox Grid.Row="2" Margin="6,0,6,10"
                             BorderThickness="0"
                             ItemsSource="{Binding CategoriasFiltradas}"
                             SelectedItem="{Binding CategoriaSeleccionada}"
                             ItemContainerStyle="{StaticResource FilaCatalogo}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding EditarCategoriaCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Descripcion}"
                                                   Style="{StaticResource TextoTenue}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Descripcion, Converter={StaticResource TextoAVisible}}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource ChipEstado}" Margin="8,0">
                                        <TextBlock Style="{StaticResource TextoChipEstado}" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Style="{StaticResource AccionesFila}">
                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EditarCategoriaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Editar">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" />
                                        </Button>

                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EliminarCategoriaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Foreground="{StaticResource BrochaError}"
                                                ToolTip="Eliminar"
                                                Visibility="{Binding DataContext.PuedeEliminar,
                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                             Converter={StaticResource BoolAVisible}}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Categorias.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                        <materialDesign:PackIcon Kind="ShapeOutline" Width="40" Height="40" Opacity="0.2"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Sin categorías todavía" Style="{StaticResource TextoTenue}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- ══ Marcas ══════════════════════════════════════════════════ -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,10,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#EDE7F6">
                                <materialDesign:PackIcon Kind="TagOutline" Width="19" Height="19"
                                                         Foreground="#5E35B1"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Marcas" Style="{StaticResource TituloSeccion}"
                                       VerticalAlignment="Center" Margin="10,0,8,0" />

                            <Border Style="{StaticResource ContadorLista}">
                                <TextBlock Text="{Binding Marcas.Count}" FontSize="11"
                                           FontWeight="SemiBold" Opacity="0.75" />
                            </Border>
                        </StackPanel>

                        <Button Style="{StaticResource BotonIconoAccion}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding NuevaMarcaCommand}"
                                Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}"
                                ToolTip="Crear una marca">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Margin="16,0,16,10"
                             Style="{StaticResource CampoBusqueda}"
                             Text="{Binding BusquedaMarcas, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             materialDesign:HintAssist.Hint="Buscar marca"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                    <ListBox Grid.Row="2" Margin="6,0,6,10"
                             BorderThickness="0"
                             ItemsSource="{Binding MarcasFiltradas}"
                             SelectedItem="{Binding MarcaSeleccionada}"
                             ItemContainerStyle="{StaticResource FilaCatalogo}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding EditarMarcaCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Descripcion}"
                                                   Style="{StaticResource TextoTenue}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Descripcion, Converter={StaticResource TextoAVisible}}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource ChipEstado}" Margin="8,0">
                                        <TextBlock Style="{StaticResource TextoChipEstado}" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Style="{StaticResource AccionesFila}">
                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EditarMarcaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Editar">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" />
                                        </Button>

                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EliminarMarcaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Foreground="{StaticResource BrochaError}"
                                                ToolTip="Eliminar"
                                                Visibility="{Binding DataContext.PuedeEliminar,
                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                             Converter={StaticResource BoolAVisible}}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Marcas.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                        <materialDesign:PackIcon Kind="TagOutline" Width="40" Height="40" Opacity="0.2"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Sin marcas todavía" Style="{StaticResource TextoTenue}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- ══ Unidades de medida ══════════════════════════════════════ -->
            <materialDesign:Card Grid.Column="4" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,10,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#E8F5E9">
                                <materialDesign:PackIcon Kind="RulerSquare" Width="19" Height="19"
                                                         Foreground="#2E7D32"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Unidades" Style="{StaticResource TituloSeccion}"
                                       VerticalAlignment="Center" Margin="10,0,8,0" />

                            <Border Style="{StaticResource ContadorLista}">
                                <TextBlock Text="{Binding Unidades.Count}" FontSize="11"
                                           FontWeight="SemiBold" Opacity="0.75" />
                            </Border>
                        </StackPanel>

                        <Button Style="{StaticResource BotonIconoAccion}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding NuevaUnidadCommand}"
                                Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}"
                                ToolTip="Crear una unidad de medida">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Margin="16,0,16,10"
                             Style="{StaticResource CampoBusqueda}"
                             Text="{Binding BusquedaUnidades, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             materialDesign:HintAssist.Hint="Buscar unidad"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                    <ListBox Grid.Row="2" Margin="6,0,6,10"
                             BorderThickness="0"
                             ItemsSource="{Binding UnidadesFiltradas}"
                             SelectedItem="{Binding UnidadSeleccionada}"
                             ItemContainerStyle="{StaticResource FilaCatalogo}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding EditarUnidadCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- La abreviatura es lo que se imprime en la factura -->
                                    <Border Grid.Column="0" CornerRadius="6" Padding="7,3"
                                            Background="{DynamicResource MaterialDesignChipBackground}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="42">
                                        <TextBlock Text="{Binding Abreviatura}" FontSize="11"
                                                   FontWeight="Bold" TextAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontWeight="SemiBold"
                                               FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Column="2" Style="{StaticResource ChipEstado}" Margin="8,0">
                                        <TextBlock Style="{StaticResource TextoChipEstado}" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Style="{StaticResource AccionesFila}">
                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EditarUnidadCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Editar">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" />
                                        </Button>

                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EliminarUnidadCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Foreground="{StaticResource BrochaError}"
                                                ToolTip="Eliminar"
                                                Visibility="{Binding DataContext.PuedeEliminar,
                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                             Converter={StaticResource BoolAVisible}}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Unidades.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                        <materialDesign:PackIcon Kind="RulerSquare" Width="40" Height="40" Opacity="0.2"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Sin unidades todavía" Style="{StaticResource TextoTenue}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
