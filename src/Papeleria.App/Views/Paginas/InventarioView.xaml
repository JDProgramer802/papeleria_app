<UserControl x:Class="Papeleria.App.Views.Paginas.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:InventarioVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1300">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <Button Style="{StaticResource BotonTexto}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding VerKardexCommand}" ToolTip="Ver el historial completo de movimientos">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="SwapHorizontalBold" VerticalAlignment="Center" />
                    <TextBlock Text="VER KARDEX" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══ Resumen del inventario ══════════════════════════════════════ -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <WrapPanel.Resources>
                <Style TargetType="materialDesign:Card" BasedOn="{StaticResource TarjetaBase}">
                    <Setter Property="Padding" Value="14" />
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="MinWidth" Value="182" />
                </Style>
            </WrapPanel.Resources>

            <materialDesign:Card>
                <StackPanel>
                    <TextBlock Text="Valor a costo" Style="{StaticResource EtiquetaCampo}" />
                    <TextBlock Text="{Binding Resumen.ValorCosto, Converter={StaticResource Moneda}}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card>
                <StackPanel>
                    <TextBlock Text="Valor a venta" Style="{StaticResource EtiquetaCampo}" />
                    <TextBlock Text="{Binding Resumen.ValorVenta, Converter={StaticResource Moneda}}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card>
                <StackPanel>
                    <TextBlock Text="Utilidad potencial" Style="{StaticResource EtiquetaCampo}" />
                    <TextBlock Text="{Binding Resumen.UtilidadPotencial, Converter={StaticResource Moneda}}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"
                               Foreground="{StaticResource BrochaExito}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card>
                <StackPanel>
                    <TextBlock Text="Unidades en bodega" Style="{StaticResource EtiquetaCampo}" />
                    <TextBlock Text="{Binding Resumen.UnidadesTotales, Converter={StaticResource Cantidad}}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card>
                <StackPanel>
                    <TextBlock Text="Bajo el mínimo" Style="{StaticResource EtiquetaCampo}" />
                    <TextBlock Text="{Binding Resumen.BajoMinimo}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"
                               Foreground="{StaticResource BrochaAdvertencia}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card>
                <StackPanel>
                    <TextBlock Text="Agotados" Style="{StaticResource EtiquetaCampo}" />
                    <TextBlock Text="{Binding Resumen.Agotados}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"
                               Foreground="{StaticResource BrochaError}" />
                </StackPanel>
            </materialDesign:Card>
        </WrapPanel>

        <!-- ══ Filtros y acciones de movimiento ════════════════════════════ -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource CampoBusqueda}"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                             materialDesign:HintAssist.Hint="Buscar producto por nombre, código o código de barras"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                    <ComboBox Grid.Column="2" Height="40"
                              ItemsSource="{Binding Categorias}"
                              SelectedValue="{Binding CategoriaSeleccionadaId}"
                              SelectedValuePath="Id" DisplayMemberPath="Nombre"
                              VerticalContentAlignment="Center" ToolTip="Filtrar por categoría" />

                    <ComboBox Grid.Column="4" Height="40"
                              ItemsSource="{Binding EstadosStock}"
                              SelectedValue="{Binding EstadoSeleccionado}"
                              SelectedValuePath="Key" DisplayMemberPath="Value"
                              VerticalContentAlignment="Center" ToolTip="Filtrar por nivel de existencias" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0"
                            Visibility="{Binding PuedeMover, Converter={StaticResource BoolAVisible}}">
                    <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                            Command="{Binding RegistrarEntradaCommand}"
                            IsEnabled="{Binding HaySeleccion}"
                            ToolTip="Registrar unidades que ingresan sin una compra">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowUpBoldBox" VerticalAlignment="Center"
                                                     Foreground="{StaticResource BrochaExito}" />
                            <TextBlock Text="Entrada" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                            Command="{Binding RegistrarSalidaCommand}"
                            IsEnabled="{Binding HaySeleccion}"
                            ToolTip="Registrar unidades que salen sin una venta">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowDownBoldBox" VerticalAlignment="Center"
                                                     Foreground="{StaticResource BrochaError}" />
                            <TextBlock Text="Salida" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                            Command="{Binding RegistrarAjusteCommand}"
                            IsEnabled="{Binding HaySeleccion}"
                            ToolTip="Cuadrar el inventario con la cantidad realmente contada">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ScaleBalance" VerticalAlignment="Center" />
                            <TextBlock Text="Ajuste" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotonSecundario}"
                            Command="{Binding RegistrarTransferenciaCommand}"
                            IsEnabled="{Binding HaySeleccion}"
                            ToolTip="Trasladar mercancía entre ubicaciones">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TransferRight" VerticalAlignment="Center" />
                            <TextBlock Text="Transferencia" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Border Grid.Row="3" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <materialDesign:Card Grid.Row="4" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
            <Grid>
                <DataGrid Style="{StaticResource GrillaDatos}"
                          ItemsSource="{Binding Existencias}"
                          SelectedItem="{Binding ProductoSeleccionado}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="9" Height="9" CornerRadius="5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding Estado, Converter={StaticResource EstadoStockABrocha}}"
                                            ToolTip="{Binding EstadoTexto}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaNombre}" Width="160" />
                        <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="120" />

                        <DataGridTextColumn Header="Existencias" Width="105"
                                            Binding="{Binding StockActual, Converter={StaticResource Cantidad}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mínimo" Width="85"
                                            Binding="{Binding StockMinimo, Converter={StaticResource Cantidad}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Máximo" Width="85"
                                            Binding="{Binding StockMaximo, Converter={StaticResource Cantidad}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Costo" Width="100"
                                            Binding="{Binding Costo, Converter={StaticResource Moneda}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Valor" Width="115"
                                            Binding="{Binding ValorInventario, Converter={StaticResource Moneda}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Existencias.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                    <materialDesign:PackIcon Kind="Warehouse" Width="52" Height="52" Opacity="0.25"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="No hay existencias que coincidan con los filtros"
                               Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <controls:PaginadorView Grid.Row="5" DataContext="{Binding Paginador}" />
    </Grid>
</UserControl>
