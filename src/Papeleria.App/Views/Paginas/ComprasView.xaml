<UserControl x:Class="Papeleria.App.Views.Paginas.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:ComprasVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1340">

    <Grid Margin="{StaticResource MargenPagina}">
        <!-- ══════════════ MODO HISTORIAL ══════════════════════════════════ -->
        <Grid Visibility="{Binding EnModoRegistro, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                    <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                            Command="{Binding VerComprobanteCommand}"
                            IsEnabled="{Binding HayCompraSeleccionada}"
                            ToolTip="Generar el comprobante en PDF">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" />
                            <TextBlock Text="Comprobante" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                            Command="{Binding AnularCompraCommand}"
                            IsEnabled="{Binding HayCompraSeleccionada}"
                            Foreground="{StaticResource BrochaError}"
                            Visibility="{Binding PuedeAnular, Converter={StaticResource BoolAVisible}}"
                            ToolTip="Anular la compra y devolver la mercancía al kardex">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" VerticalAlignment="Center" />
                            <TextBlock Text="Anular" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotonPrincipal}"
                            Command="{Binding NuevaCompraCommand}"
                            Visibility="{Binding PuedeRegistrar, Converter={StaticResource BoolAVisible}}"
                            ToolTip="Registrar una compra nueva">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartPlus" VerticalAlignment="Center" />
                            <TextBlock Text="NUEVA COMPRA" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <materialDesign:Card Grid.Row="1" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource CampoBusqueda}"
                             Text="{Binding TextoBusquedaHistorial, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             materialDesign:HintAssist.Hint="Buscar por número, factura del proveedor o proveedor"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                    <DatePicker Grid.Column="2" Height="40" SelectedDate="{Binding Desde}"
                                materialDesign:HintAssist.Hint="Desde" VerticalContentAlignment="Center" />

                    <DatePicker Grid.Column="4" Height="40" SelectedDate="{Binding Hasta}"
                                materialDesign:HintAssist.Hint="Hasta" VerticalContentAlignment="Center" />

                    <Button Grid.Column="6" Style="{StaticResource BotonSecundario}"
                            VerticalAlignment="Center" Command="{Binding BuscarCommand}"
                            ToolTip="Aplicar los filtros">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" />
                            <TextBlock Text="Buscar" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <Border Grid.Row="2" Background="{StaticResource BrochaErrorSuave}"
                    CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
                <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                           TextWrapping="Wrap" FontSize="12.5" />
            </Border>

            <materialDesign:Card Grid.Row="3" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <DataGrid Style="{StaticResource GrillaDatos}"
                              ItemsSource="{Binding Historial}"
                              SelectedItem="{Binding CompraSeleccionada}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding VerComprobanteCommand}" />
                        </DataGrid.InputBindings>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="130" />
                            <DataGridTextColumn Header="Fecha" Width="150"
                                                Binding="{Binding Fecha, Converter={StaticResource Fecha}, ConverterParameter=Hora}" />
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="*" />
                            <DataGridTextColumn Header="Fact. proveedor"
                                                Binding="{Binding NumeroFacturaProveedor}" Width="130" />
                            <DataGridTextColumn Header="Registró" Binding="{Binding UsuarioNombre}" Width="160" />

                            <DataGridTextColumn Header="Ítems" Binding="{Binding CantidadItems}" Width="70"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="IVA" Width="105"
                                                Binding="{Binding TotalIva, Converter={StaticResource Moneda}}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Total" Width="125"
                                                Binding="{Binding Total, Converter={StaticResource Moneda}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Estado" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Distintivo}">
                                                    <Setter Property="Background" Value="#43A047" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaAnulada}" Value="True">
                                                            <Setter Property="Background" Value="#E53935" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoTexto}"
                                                       Style="{StaticResource TextoDistintivo}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Historial.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                        <materialDesign:PackIcon Kind="TruckRemoveOutline" Width="52" Height="52"
                                                 Opacity="0.25" HorizontalAlignment="Center" />
                        <TextBlock Text="No hay compras registradas en el periodo"
                                   Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <controls:PaginadorView Grid.Row="4" DataContext="{Binding Paginador}" />
        </Grid>

        <!-- ══════════════ MODO REGISTRO ═══════════════════════════════════ -->
        <Grid Visibility="{Binding EnModoRegistro, Converter={StaticResource BoolAVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Registrar compra" Style="{StaticResource TituloPagina}" />
                    <TextBlock Text="Al guardar se actualizan las existencias, el costo promedio y el kardex"
                               Style="{StaticResource SubtituloPagina}" />
                </StackPanel>

                <Button Style="{StaticResource BotonTexto}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding CancelarRegistroCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" />
                        <TextBlock Text="VOLVER AL HISTORIAL" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Datos del documento -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource TarjetaBase}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Style="{StaticResource CampoSeleccion}"
                              ItemsSource="{Binding Proveedores}"
                              SelectedValue="{Binding ProveedorId}"
                              SelectedValuePath="Id" DisplayMemberPath="Nombre"
                              materialDesign:HintAssist.Hint="Proveedor"
                              materialDesign:HintAssist.IsFloating="True"
                              IsEditable="False" />

                    <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}"
                             Text="{Binding NumeroFacturaProveedor, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             materialDesign:HintAssist.Hint="Factura del proveedor"
                             materialDesign:HintAssist.IsFloating="True" />

                    <DatePicker Grid.Column="4" Style="{StaticResource CampoFecha}"
                                SelectedDate="{Binding FechaCompra}"
                                materialDesign:HintAssist.Hint="Fecha"
                                materialDesign:HintAssist.IsFloating="True" />

                    <TextBox Grid.Column="6" Style="{StaticResource CampoTexto}"
                             Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="600"
                             materialDesign:HintAssist.Hint="Observaciones"
                             materialDesign:HintAssist.IsFloating="True" />
                </Grid>
            </materialDesign:Card>

            <!-- Buscador de productos -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource CampoBusqueda}"
                                 Text="{Binding TextoBusquedaProducto, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 materialDesign:HintAssist.Hint="Buscar el producto a comprar (nombre, código o código de barras)"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                        <Button Grid.Column="1" Style="{StaticResource BotonSecundario}"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                Command="{Binding AplicarIvaGeneralCommand}"
                                ToolTip="Aplicar a todas las líneas el IVA configurado por defecto">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PercentOutline" VerticalAlignment="Center" />
                                <TextBlock Text="IVA general" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Resultados de la búsqueda -->
                    <ItemsControl ItemsSource="{Binding ResultadosBusqueda}" Margin="0,10,0,0"
                                  MaxHeight="150"
                                  Visibility="{Binding ResultadosBusqueda.Count, Converter={StaticResource ColeccionVaciaAVisible}, ConverterParameter=Invertir}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,4" Cursor="Hand"
                                        Background="{DynamicResource MaterialDesignChipBackground}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.AgregarProductoCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Codigo}" FontFamily="Consolas"
                                                       Opacity="0.7" VerticalAlignment="Center"
                                                       Width="90" />
                                            <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="12">
                                                <Run Text="Existencias:" />
                                                <Run Text="{Binding StockActual, Converter={StaticResource Cantidad}, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Costo, Converter={StaticResource Moneda}}"
                                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <!-- Líneas de la compra -->
            <materialDesign:Card Grid.Row="3" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0,0,0,12">
                <Grid>
                    <DataGrid Style="{StaticResource GrillaEditable}"
                              ItemsSource="{Binding Lineas}"
                              SelectedItem="{Binding LineaSeleccionada}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadAbreviatura}" Width="80"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="Cantidad" Width="95"
                                                Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Costo unit." Width="115"
                                                Binding="{Binding CostoUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Desc. %" Width="85"
                                                Binding="{Binding PorcentajeDescuento, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="IVA %" Width="80"
                                                Binding="{Binding PorcentajeIva, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Total" Width="125" IsReadOnly="True"
                                                Binding="{Binding Total, Converter={StaticResource Moneda}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="" Width="50" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Foreground="{StaticResource BrochaError}"
                                                Command="{Binding DataContext.QuitarLineaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Quitar la línea">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HayLineas, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                        <materialDesign:PackIcon Kind="CartOutline" Width="52" Height="52"
                                                 Opacity="0.25" HorizontalAlignment="Center" />
                        <TextBlock Text="Busque productos arriba para agregarlos a la compra"
                                   Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Totales y guardado -->
            <materialDesign:Card Grid.Row="4" Style="{StaticResource TarjetaBase}" Padding="16" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrochaErrorSuave}"
                                CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
                            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                                       TextWrapping="Wrap" FontSize="12.5" MaxWidth="560" />
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TextoTenue}" VerticalAlignment="Center">
                                <Run Text="{Binding CantidadLineas, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="línea(s) en la compra" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0" MinWidth="210">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Subtotal" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding Subtotal, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Descuentos" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding TotalDescuento, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource BrochaError}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="IVA" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding TotalIva, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="TOTAL" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Total, Converter={StaticResource Moneda}}"
                                               HorizontalAlignment="Right" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Button Style="{StaticResource BotonPrincipal}"
                                Height="56" MinWidth="200" VerticalAlignment="Center"
                                Command="{Binding GuardarCompraCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheckOutline"
                                                         Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="REGISTRAR COMPRA" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
