<UserControl x:Class="Papeleria.App.Views.Paginas.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:ProductosVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1300">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Encabezado y acciones ═══════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding ImprimirEtiquetaCommand}"
                        IsEnabled="{Binding HaySeleccion}"
                        ToolTip="Generar una hoja de etiquetas con código de barras">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BarcodeScan" VerticalAlignment="Center" />
                        <TextBlock Text="Etiquetas" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding RegistrarCompraCommand}"
                        IsEnabled="{Binding HaySeleccion}"
                        Visibility="{Binding PuedeComprar, Converter={StaticResource BoolAVisible}}"
                        ToolTip="Registrar una compra a proveedor de este producto">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TruckDeliveryOutline" VerticalAlignment="Center" />
                        <TextBlock Text="Comprar" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding DuplicarCommand}"
                        IsEnabled="{Binding HaySeleccion}"
                        Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}"
                        ToolTip="Crear una copia del producto seleccionado">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentDuplicate" VerticalAlignment="Center" />
                        <TextBlock Text="Duplicar" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonPrincipal}"
                        Command="{Binding NuevoCommand}"
                        Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}"
                        ToolTip="Registrar un producto nuevo">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                        <TextBlock Text="NUEVO PRODUCTO" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ Filtros ═════════════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource CampoBusqueda}"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                         materialDesign:HintAssist.Hint="Buscar por nombre, código o código de barras"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                <ComboBox Grid.Column="2" Style="{StaticResource FiltroSeleccion}"
                          materialDesign:HintAssist.Hint="Categoría"
                          ItemsSource="{Binding FiltroCategorias}"
                          SelectedValue="{Binding CategoriaSeleccionadaId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Nombre"
                          VerticalContentAlignment="Center"
                          ToolTip="Filtrar por categoría" />

                <ComboBox Grid.Column="4" Style="{StaticResource FiltroSeleccion}"
                          materialDesign:HintAssist.Hint="Marca"
                          ItemsSource="{Binding FiltroMarcas}"
                          SelectedValue="{Binding MarcaSeleccionadaId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Nombre"
                          VerticalContentAlignment="Center"
                          ToolTip="Filtrar por marca" />

                <ComboBox Grid.Column="6" Style="{StaticResource FiltroSeleccion}"
                          materialDesign:HintAssist.Hint="Existencias"
                          ItemsSource="{Binding EstadosStock}"
                          SelectedValue="{Binding EstadoSeleccionado}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          VerticalContentAlignment="Center"
                          ToolTip="Filtrar por nivel de existencias" />

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Solo activos" IsChecked="{Binding SoloActivos}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Button Style="{StaticResource BotonIconoAccion}"
                            Command="{Binding LimpiarFiltrosCommand}"
                            ToolTip="Limpiar todos los filtros">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ══ Mensaje de error ════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <!-- ══ Grilla ══════════════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="3" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
            <Grid>
                <DataGrid Style="{StaticResource GrillaDatos}"
                          ItemsSource="{Binding Productos}"
                          SelectedItem="{Binding ProductoSeleccionado}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditarCommand}" />
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Semáforo de existencias -->
                                    <Border Width="9" Height="9" CornerRadius="5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding Estado, Converter={StaticResource EstadoStockABrocha}}"
                                            ToolTip="{Binding EstadoTexto}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" />

                        <DataGridTemplateColumn Header="Producto" Width="*" SortMemberPath="Nombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource TextoTenue}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding CategoriaNombre, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding MarcaNombre, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="C. barras" Binding="{Binding CodigoBarras}" Width="130" />

                        <DataGridTemplateColumn Header="Existencias" Width="120" SortMemberPath="StockActual">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                            <Run Text="{Binding StockActual, Converter={StaticResource Cantidad}, Mode=OneWay}" />
                                            <Run Text="{Binding UnidadAbreviatura, Mode=OneWay}" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource TextoTenue}" FontSize="10.5"
                                                   HorizontalAlignment="Right">
                                            <Run Text="mín." />
                                            <Run Text="{Binding StockMinimo, Converter={StaticResource Cantidad}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Costo" Width="100"
                                            Binding="{Binding Costo, Converter={StaticResource Moneda}}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                        <DataGridTextColumn Header="P. venta" Width="105"
                                            Binding="{Binding PrecioVenta, Converter={StaticResource Moneda}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Margen" Width="85"
                                            Binding="{Binding MargenPorcentaje, Converter={StaticResource Porcentaje}}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                        <DataGridTextColumn Header="IVA" Width="70"
                                            Binding="{Binding PorcentajeIva, Converter={StaticResource Porcentaje}, ConverterParameter=0}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                        <DataGridTemplateColumn Header="Estado" Width="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Distintivo}">
                                                <Setter Property="Background" Value="#9E9E9E" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="True">
                                                        <Setter Property="Background" Value="#43A047" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoDistintivo}">
                                                    <Setter Property="Text" Value="Inactivo" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="True">
                                                            <Setter Property="Text" Value="Activo" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="164" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.RegistrarCompraCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding DataContext.PuedeComprar,
                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                             Converter={StaticResource BoolAVisible}}"
                                                ToolTip="Registrar una compra de este producto">
                                            <materialDesign:PackIcon Kind="TruckDeliveryOutline" Width="17" Height="17" />
                                        </Button>

                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EditarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Editar el producto">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="17" Height="17" />
                                        </Button>

                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.AlternarEstadoCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Activar o desactivar">
                                            <materialDesign:PackIcon Kind="PowerStandby" Width="17" Height="17" />
                                        </Button>

                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Command="{Binding DataContext.EliminarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Foreground="{StaticResource BrochaError}"
                                                ToolTip="Eliminar el producto">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Estado vacío -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Productos.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                    <materialDesign:PackIcon Kind="PackageVariantClosedRemove"
                                             Width="52" Height="52" Opacity="0.25"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="No hay productos que coincidan con la búsqueda"
                               Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="40" Height="40"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}" />
            </Grid>
        </materialDesign:Card>

        <controls:PaginadorView Grid.Row="4" DataContext="{Binding Paginador}" />
    </Grid>
</UserControl>
