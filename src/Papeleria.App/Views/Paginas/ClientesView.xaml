<UserControl x:Class="Papeleria.App.Views.Paginas.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:ClientesVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1300">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <Button Style="{StaticResource BotonPrincipal}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding NuevoCommand}"
                    Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}"
                    ToolTip="Registrar un cliente nuevo">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlusOutline" VerticalAlignment="Center" />
                    <TextBlock Text="NUEVO CLIENTE" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.9*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Style="{StaticResource TarjetaBase}"
                                     Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource CampoBusqueda}"
                                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 materialDesign:HintAssist.Hint="Buscar nombre, documento, teléfono o correo"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                        <CheckBox Grid.Column="1" Content="Solo activos"
                                  IsChecked="{Binding SoloActivos}"
                                  VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                    <Grid>
                        <DataGrid Style="{StaticResource GrillaDatos}"
                                  ItemsSource="{Binding Clientes}"
                                  SelectedItem="{Binding ClienteSeleccionado}">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditarCommand}" />
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Cliente" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Star" Width="14" Height="14"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         Foreground="{StaticResource BrochaAdvertencia}"
                                                                         ToolTip="Cliente por defecto del punto de venta"
                                                                         Visibility="{Binding EsProtegido, Converter={StaticResource BoolAVisible}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nombre}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource TextoTenue}" FontSize="11">
                                                        <Run Text="{Binding TipoDocumento, Converter={StaticResource EnumADescripcion}, Mode=OneWay}" />
                                                        <Run Text="{Binding NumeroDocumento, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" />
                                <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="180" />
                                <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="110" />

                                <DataGridTemplateColumn Header="Estado" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Distintivo}">
                                                        <Setter Property="Background" Value="#9E9E9E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                <Setter Property="Background" Value="#43A047" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource TextoDistintivo}">
                                                            <Setter Property="Text" Value="Inactivo" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                    <Setter Property="Text" Value="Activo" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="126" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource BotonIconoAccion}"
                                                        Command="{Binding DataContext.EditarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="Editar el cliente">
                                                    <materialDesign:PackIcon Kind="PencilOutline"
                                                                             Width="17" Height="17" />
                                                </Button>
                                                <Button Style="{StaticResource BotonIconoAccion}"
                                                        Command="{Binding DataContext.AlternarEstadoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}"
                                                        ToolTip="Activar o desactivar">
                                                    <materialDesign:PackIcon Kind="PowerStandby"
                                                                             Width="17" Height="17" />
                                                </Button>
                                                <Button Style="{StaticResource BotonIconoAccion}"
                                                        Command="{Binding DataContext.EliminarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}"
                                                        Foreground="{StaticResource BrochaError}"
                                                        ToolTip="Eliminar el cliente">
                                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                                             Width="17" Height="17" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Clientes.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                            <materialDesign:PackIcon Kind="AccountOff" Width="48" Height="48"
                                                     Opacity="0.25" HorizontalAlignment="Center" />
                            <TextBlock Text="No hay clientes que coincidan con la búsqueda"
                                       Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <controls:PaginadorView Grid.Row="2" DataContext="{Binding Paginador}" />
            </Grid>

            <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Margin="0">
                <Grid>
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                        <materialDesign:PackIcon Kind="GestureTapButton" Width="42" Height="42"
                                                 Opacity="0.25" HorizontalAlignment="Center" />
                        <TextBlock Text="Seleccione un cliente para ver su historial de facturas"
                                   Style="{StaticResource TextoTenue}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <Grid Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding ClienteSeleccionado.Nombre}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       TextWrapping="Wrap" />

                            <StackPanel Margin="0,10,0,0">
                                <StackPanel Style="{StaticResource FilaContacto}">
                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline"
                                                             Style="{StaticResource IconoContacto}" />
                                    <TextBlock Text="{Binding ClienteSeleccionado.NumeroDocumento}"
                                               Style="{StaticResource TextoContacto}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FilaContacto}">
                                    <materialDesign:PackIcon Kind="PhoneOutline"
                                                             Style="{StaticResource IconoContacto}" />
                                    <TextBlock Text="{Binding ClienteSeleccionado.Telefono}"
                                               Style="{StaticResource TextoContacto}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FilaContacto}">
                                    <materialDesign:PackIcon Kind="EmailOutline"
                                                             Style="{StaticResource IconoContacto}" />
                                    <TextBlock Text="{Binding ClienteSeleccionado.Correo}"
                                               Style="{StaticResource TextoContacto}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FilaContacto}">
                                    <materialDesign:PackIcon Kind="MapMarkerOutline"
                                                             Style="{StaticResource IconoContacto}" />
                                    <TextBlock Text="{Binding ClienteSeleccionado.Direccion}"
                                               Style="{StaticResource TextoContacto}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Separator Style="{StaticResource SeparadorHorizontal}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Facturas" Style="{StaticResource EtiquetaCampo}" />
                                    <TextBlock Text="{Binding ResumenSeleccionado.CantidadDocumentos}"
                                               FontSize="18" FontWeight="Bold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Total comprado" Style="{StaticResource EtiquetaCampo}" />
                                    <TextBlock Text="{Binding ResumenSeleccionado.MontoTotal, Converter={StaticResource Moneda}}"
                                               FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource TextoTenue}" FontSize="11.5" Margin="0,8,0,0">
                                <Run Text="Ticket promedio:" />
                                <Run Text="{Binding ResumenSeleccionado.PromedioDocumento, Converter={StaticResource Moneda}, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="Historial de facturas" Style="{StaticResource TituloSeccion}"
                                       Margin="0,14,0,8" />
                        </StackPanel>

                        <DataGrid Grid.Row="2" Style="{StaticResource GrillaDatos}"
                                  ItemsSource="{Binding Historial}"
                                  RowHeight="38" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Factura" Binding="{Binding NumeroFactura}" Width="*" />
                                <DataGridTextColumn Header="Fecha" Width="95"
                                                    Binding="{Binding Fecha, Converter={StaticResource Fecha}}" />
                                <DataGridTextColumn Header="Total" Width="110"
                                                    Binding="{Binding Total, Converter={StaticResource Moneda}}"
                                                    HeaderStyle="{StaticResource EncabezadoNumerico}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CeldaNumerica}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
