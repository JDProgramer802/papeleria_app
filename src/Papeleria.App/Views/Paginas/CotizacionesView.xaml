<UserControl x:Class="Papeleria.App.Views.Paginas.CotizacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:CotizacionesVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1400">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Encabezado ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <Button Style="{StaticResource BotonPrincipal}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding IrAPuntoDeVentaCommand}"
                    ToolTip="Las cotizaciones se arman en el punto de venta, con el mismo carrito">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                    <TextBlock Text="NUEVA COTIZACIÓN" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══ Filtros ═════════════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource CampoBusqueda}"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         materialDesign:HintAssist.Hint="Buscar número, cliente o documento" />

                <DatePicker Grid.Column="2" Style="{StaticResource FiltroFecha}"
                            SelectedDate="{Binding Desde}"
                            materialDesign:HintAssist.Hint="Desde" />

                <DatePicker Grid.Column="4" Style="{StaticResource FiltroFecha}"
                            SelectedDate="{Binding Hasta}"
                            materialDesign:HintAssist.Hint="Hasta" />

                <ComboBox Grid.Column="6" Style="{StaticResource FiltroSeleccion}"
                          materialDesign:HintAssist.Hint="Estado"
                          ItemsSource="{Binding Estados}"
                          SelectedValue="{Binding EstadoSeleccionado}"
                          SelectedValuePath="Valor"
                          DisplayMemberPath="Descripcion"
                          ToolTip="Filtrar por estado de la cotización" />

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Solo vigentes" IsChecked="{Binding SoloVigentes}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Deja fuera las vencidas, las rechazadas y las ya facturadas" />

                    <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                            Command="{Binding BuscarCommand}"
                            Content="Buscar" />

                    <Button Style="{StaticResource BotonIconoAccion}"
                            Command="{Binding LimpiarFiltrosCommand}"
                            ToolTip="Limpiar todos los filtros">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ══ Lista y detalle ═════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Style="{StaticResource TarjetaBase}"
                                     Padding="0" Margin="0">
                    <Grid>
                        <DataGrid Style="{StaticResource GrillaDatos}"
                                  ItemsSource="{Binding Cotizaciones}"
                                  SelectedItem="{Binding Seleccionada}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="110" />

                                <DataGridTemplateColumn Header="Fecha" Width="110" SortMemberPath="Fecha">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Fecha, Converter={StaticResource Fecha}}"
                                                           FontSize="12.5" />
                                                <TextBlock Text="{Binding VigenciaTexto}"
                                                           Style="{StaticResource TextoTenue}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" />

                                <DataGridTextColumn Header="Ítems" Binding="{Binding CantidadItems}" Width="70"
                                                    ElementStyle="{StaticResource CeldaNumerica}"
                                                    HeaderStyle="{StaticResource EncabezadoNumerico}" />

                                <DataGridTextColumn Header="Total" Width="120"
                                                    Binding="{Binding Total, Converter={StaticResource Moneda}}"
                                                    HeaderStyle="{StaticResource EncabezadoNumerico}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CeldaNumerica}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Estado" Width="120" SortMemberPath="Estado">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="9,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrochaInformacionSuave}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstadoTexto}" Value="Aceptada">
                                                                <Setter Property="Background" Value="{StaticResource BrochaExitoSuave}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoTexto}" Value="Vencida">
                                                                <Setter Property="Background" Value="{StaticResource BrochaAdvertenciaSuave}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoTexto}" Value="Rechazada">
                                                                <Setter Property="Background" Value="{StaticResource BrochaErrorSuave}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding EstadoTexto}"
                                                           FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrochaInformacion}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoTexto}" Value="Aceptada">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrochaExito}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EstadoTexto}" Value="Vencida">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrochaAdvertencia}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EstadoTexto}" Value="Rechazada">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrochaError}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Factura" Binding="{Binding NumeroFactura}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Cotizaciones.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="52" Height="52"
                                                     Opacity="0.2" HorizontalAlignment="Center" />
                            <TextBlock Text="No hay cotizaciones en el periodo"
                                       Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <controls:PaginadorView Grid.Row="1" DataContext="{Binding Paginador}" />
            </Grid>

            <!-- ══ Detalle ═════════════════════════════════════════════════ -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Margin="0">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                        <materialDesign:PackIcon Kind="GestureTapButton" Width="42" Height="42"
                                                 Opacity="0.2" HorizontalAlignment="Center" />
                        <TextBlock Text="Elija una cotización para ver el detalle"
                                   Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding Detalle.Numero}" Style="{StaticResource TituloSeccion}"
                                       Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource TextoTenue}" FontSize="12">
                                <Run Text="{Binding Detalle.ClienteNombre, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Detalle.VigenciaTexto}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />

                            <Separator Style="{StaticResource SeparadorHorizontal}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Detalle.Lineas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="6" Padding="7,3"
                                                    VerticalAlignment="Top" Margin="0,1,10,0"
                                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}">
                                                <TextBlock Text="{Binding Cantidad, Converter={StaticResource Cantidad}}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Descripcion}" FontSize="12.5"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource TextoTenue}" FontSize="11">
                                                    <Run Text="{Binding PrecioUnitario, Converter={StaticResource Moneda}, Mode=OneWay}" />
                                                    <Run Text="c/u" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       Text="{Binding Total, Converter={StaticResource Moneda}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <Separator Style="{StaticResource SeparadorHorizontal}" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Subtotal" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding Detalle.Subtotal, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>

                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding Detalle.TotalDescuento, Converter={StaticResource MayorQueCeroAVisible}}">
                                <TextBlock Text="Descuentos" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding Detalle.TotalDescuento, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" FontSize="12.5"
                                           Foreground="{StaticResource BrochaError}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="IVA" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding Detalle.TotalIva, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="TOTAL" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Detalle.Total, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" FontSize="21" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Grid>

                            <TextBlock Text="{Binding Detalle.Observaciones}"
                                       Style="{StaticResource TextoTenue}" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding Detalle.Observaciones, Converter={StaticResource TextoAVisible}}" />

                            <Button Style="{StaticResource BotonPrincipal}" Height="44"
                                    Command="{Binding FacturarCommand}"
                                    IsEnabled="{Binding Seleccionada.SePuedeConvertir}"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashRegister" VerticalAlignment="Center" />
                                    <TextBlock Text="FACTURAR" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource BotonSecundario}"
                                        Command="{Binding ImprimirCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PrinterOutline" VerticalAlignment="Center" />
                                        <TextBlock Text="Imprimir" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Style="{StaticResource BotonPeligro}"
                                        Command="{Binding RechazarCommand}"
                                        IsEnabled="{Binding Seleccionada.SePuedeConvertir}"
                                        Content="Rechazar" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Indicador de carga -->
        <Border Grid.RowSpan="3" Background="{DynamicResource MaterialDesignPaper}" Opacity="0.7"
                Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="46" Height="46"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
