<UserControl x:Class="Papeleria.App.Views.Paginas.KardexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:KardexVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1300">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding ExportarExcelCommand}" ToolTip="Exportar a Excel">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center" />
                        <TextBlock Text="Excel" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding ExportarPdfCommand}" ToolTip="Exportar a PDF">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" />
                        <TextBlock Text="PDF" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonSecundario}"
                        Command="{Binding ExportarCsvCommand}" ToolTip="Exportar a CSV">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDelimitedOutline" VerticalAlignment="Center" />
                        <TextBlock Text="CSV" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Aviso de inmutabilidad -->
        <Border Grid.Row="1" Background="{StaticResource BrochaInformacionSuave}"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ShieldLockOutline"
                                         Foreground="{StaticResource BrochaInformacion}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="El kardex es un registro histórico inalterable: los movimientos no pueden modificarse ni eliminarse, ni desde la aplicación ni desde la base de datos."
                           Foreground="{StaticResource BrochaInformacion}"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           TextWrapping="Wrap" FontSize="12.5" />
            </StackPanel>
        </Border>

        <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource CampoBusqueda}"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         materialDesign:HintAssist.Hint="Buscar por producto, motivo o documento"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                <ComboBox Grid.Column="2" Style="{StaticResource FiltroSeleccion}"
                          materialDesign:HintAssist.Hint="Tipo de movimiento"
                          ItemsSource="{Binding TiposMovimiento}"
                          SelectedValue="{Binding TipoSeleccionado}"
                          SelectedValuePath="Key" DisplayMemberPath="Value"
                          VerticalContentAlignment="Center" ToolTip="Filtrar por tipo de movimiento" />

                <DatePicker Grid.Column="4" Style="{StaticResource FiltroFecha}"
                            SelectedDate="{Binding Desde}"
                            materialDesign:HintAssist.Hint="Desde"
                            VerticalContentAlignment="Center" />

                <DatePicker Grid.Column="6" Style="{StaticResource FiltroFecha}"
                            SelectedDate="{Binding Hasta}"
                            materialDesign:HintAssist.Hint="Hasta"
                            VerticalContentAlignment="Center" />

                <Button Grid.Column="8" Style="{StaticResource BotonIconoAccion}"
                        VerticalAlignment="Center"
                        Command="{Binding LimpiarFiltrosCommand}"
                        ToolTip="Restablecer los filtros">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" />
                </Button>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="3" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
            <Grid>
                <DataGrid Style="{StaticResource GrillaDatos}" ItemsSource="{Binding Movimientos}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Width="140"
                                            Binding="{Binding Fecha, Converter={StaticResource Fecha}, ConverterParameter=Hora}" />

                        <DataGridTemplateColumn Header="Producto" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductoNombre}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProductoCodigo}"
                                                   Style="{StaticResource TextoTenue}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Movimiento" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="SwapHorizontal" />
                                                    <Setter Property="Foreground" Value="Gray" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsEntrada}" Value="True">
                                                            <Setter Property="Kind" Value="ArrowUpBold" />
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource BrochaExito}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EsSalida}" Value="True">
                                                            <Setter Property="Kind" Value="ArrowDownBold" />
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource BrochaError}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <TextBlock Text="{Binding TipoTexto}" VerticalAlignment="Center"
                                                   Margin="7,0,0,0" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Entrada" Width="85"
                                            Binding="{Binding Entrada, Converter={StaticResource Cantidad}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource BrochaExito}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Salida" Width="85"
                                            Binding="{Binding Salida, Converter={StaticResource Cantidad}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource BrochaError}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Stock ant." Width="95"
                                            Binding="{Binding StockAnterior, Converter={StaticResource Cantidad}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Stock nuevo" Width="100"
                                            Binding="{Binding StockNuevo, Converter={StaticResource Cantidad}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Documento" Binding="{Binding DocumentoReferencia}" Width="120" />
                        <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioNombre}" Width="150" />
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="260" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Movimientos.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                    <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="52" Height="52"
                                             Opacity="0.25" HorizontalAlignment="Center" />
                    <TextBlock Text="No hay movimientos en el periodo seleccionado"
                               Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <controls:PaginadorView Grid.Row="4" DataContext="{Binding Paginador}" />
    </Grid>
</UserControl>
