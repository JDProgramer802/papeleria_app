<UserControl x:Class="Papeleria.App.Views.Paginas.PuntoVentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:PuntoVentaVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1340">

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════ COLUMNA IZQUIERDA: búsqueda y carrito ═══════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <!-- Aviso de caja cerrada -->
            <Border Grid.Row="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,12"
                    Background="{StaticResource BrochaAdvertenciaSuave}"
                    Visibility="{Binding CajaAbierta, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockAlertOutline"
                                                 Foreground="{StaticResource BrochaAdvertencia}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="La caja está cerrada. Debe abrirla antes de poder facturar."
                                   Foreground="{StaticResource BrochaAdvertencia}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontWeight="SemiBold" FontSize="12.5" />
                    </StackPanel>

                    <Button Style="{StaticResource BotonSecundario}"
                            HorizontalAlignment="Right" Height="32"
                            Command="{Binding IrACajaCommand}"
                            Content="ABRIR CAJA" FontSize="11" />
                </Grid>
            </Border>

            <!-- Buscador / lector de código de barras -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBox x:Name="CampoBusqueda"
                             Style="{StaticResource CampoBusqueda}"
                             MinHeight="56" FontSize="16"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             materialDesign:HintAssist.Hint="Escanee el código de barras o escriba el nombre del producto"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="BarcodeScan"
                             ToolTip="Pulse Enter para agregar el producto al carrito">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ProcesarCodigoCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Resultados -->
                    <ItemsControl ItemsSource="{Binding Resultados}" MaxHeight="220" Margin="0,4,0,0"
                                  Visibility="{Binding Resultados.Count, Converter={StaticResource ColeccionVaciaAVisible}, ConverterParameter=Invertir}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource MaterialDesignChipBackground}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MaterialDesignChipBackground}" />
                                                </Trigger>
                                                <!-- Los agotados se muestran atenuados y no se pueden agregar. -->
                                                <DataTrigger Binding="{Binding HayExistencias}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.AgregarProductoCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource TextoTenue}" FontSize="11">
                                                    <Run Text="{Binding Codigo, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding CategoriaNombre, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <StackPanel Margin="0,0,14,0">
                                                <!-- Un servicio dice «Servicio», no «Disp. 0». -->
                                                <TextBlock HorizontalAlignment="Right" FontSize="11"
                                                           Style="{StaticResource TextoTenue}"
                                                           Text="{Binding ExistenciasTexto, Mode=OneWay}" />
                                                <TextBlock Text="AGOTADO" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource BrochaError}"
                                                           Visibility="{Binding HayExistencias, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding PrecioVenta, Converter={StaticResource Moneda}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="15" FontWeight="Bold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <Border Grid.Row="3" Background="{StaticResource BrochaErrorSuave}"
                    CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Foreground="{StaticResource BrochaError}"
                                             VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                               TextWrapping="Wrap" FontSize="12.5" />
                </StackPanel>
            </Border>

            <!-- Carrito -->
            <materialDesign:Card Grid.Row="4" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <DataGrid Style="{StaticResource GrillaEditable}"
                              ItemsSource="{Binding Carrito}"
                              SelectedItem="{Binding LineaSeleccionada}"
                              RowHeight="48">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource FilaGrilla}">
                                <Style.Triggers>
                                    <!-- Resalta las líneas que superan las existencias. -->
                                    <DataTrigger Binding="{Binding ExcedeStock}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrochaErrorSuave}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Producto" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource TextoTenue}" FontSize="11">
                                                <Run Text="{Binding Codigo, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding DisponibilidadTexto, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Cantidad" Width="140" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource BotonIconoAccion}"
                                                    Width="28" Height="28"
                                                    Command="{Binding DataContext.DisminuirCantidadCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Quitar una unidad">
                                                <materialDesign:PackIcon Kind="Minus" Width="15" Height="15" />
                                            </Button>

                                            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Width="46" Margin="4,0"
                                                     TextAlignment="Center" FontWeight="SemiBold"
                                                     VerticalContentAlignment="Center"
                                                     BorderThickness="0" />

                                            <Button Style="{StaticResource BotonIconoAccion}"
                                                    Width="28" Height="28"
                                                    Command="{Binding DataContext.AumentarCantidadCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Agregar una unidad">
                                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Precio" Width="110"
                                                Binding="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Desc. %" Width="80"
                                                Binding="{Binding PorcentajeDescuento, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                            <DataGridTextColumn Header="Total" Width="120" IsReadOnly="True"
                                                Binding="{Binding Total, Converter={StaticResource Moneda}}"
                                                HeaderStyle="{StaticResource EncabezadoNumerico}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CeldaNumerica}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="" Width="46" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BotonIconoAccion}"
                                                Foreground="{StaticResource BrochaError}"
                                                Command="{Binding DataContext.QuitarLineaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Quitar del carrito">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HayLineas, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                        <materialDesign:PackIcon Kind="CartOutline" Width="60" Height="60"
                                                 Opacity="0.22" HorizontalAlignment="Center" />
                        <TextBlock Text="Escanee un producto para comenzar la venta"
                                   Style="{StaticResource TextoTenue}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ══════════════ COLUMNA DERECHA: cliente y totales ══════════════ -->
        <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Margin="0" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Resumen de la venta" Style="{StaticResource TituloSeccion}" />

                    <!-- El cliente nuevo se crea aquí mismo para no abandonar la venta. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Style="{StaticResource CampoSeleccion}"
                                  ItemsSource="{Binding Clientes}"
                                  SelectedValue="{Binding ClienteId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Nombre"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Nombre"
                                  materialDesign:HintAssist.Hint="Cliente"
                                  materialDesign:HintAssist.IsFloating="True"
                                  ToolTip="Cliente al que se emite la factura. Escriba para buscarlo." />

                        <Button Grid.Column="1"
                                Style="{StaticResource BotonIconoAccion}"
                                Margin="6,0,0,16"
                                VerticalAlignment="Center"
                                Command="{Binding NuevoClienteCommand}"
                                Visibility="{Binding PuedeCrearClientes, Converter={StaticResource BoolAVisible}}"
                                ToolTip="Crear un cliente nuevo sin salir de la venta">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="20" Height="20" />
                        </Button>
                    </Grid>

                    <TextBox Style="{StaticResource CampoTexto}"
                             Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="600"
                             materialDesign:HintAssist.Hint="Observaciones (opcional)"
                             materialDesign:HintAssist.IsFloating="True" />
                </StackPanel>

                <Separator Grid.Row="1" Style="{StaticResource SeparadorHorizontal}" />

                <!-- Totales -->
                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Artículos" Style="{StaticResource TextoTenue}" />
                        <TextBlock Text="{Binding CantidadArticulos}" HorizontalAlignment="Right"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Subtotal" Style="{StaticResource TextoTenue}" />
                        <TextBlock Text="{Binding Subtotal, Converter={StaticResource Moneda}}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding TotalDescuento, Converter={StaticResource MayorQueCeroAVisible}}">
                        <TextBlock Text="Descuentos" Style="{StaticResource TextoTenue}" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource BrochaError}">
                            <Run Text="-" />
                            <Run Text="{Binding TotalDescuento, Converter={StaticResource Moneda}, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="IVA" Style="{StaticResource TextoTenue}" />
                        <TextBlock Text="{Binding TotalIva, Converter={StaticResource Moneda}}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Total destacado -->
                <Border Grid.Row="3" CornerRadius="10" Padding="16,14" Margin="0,10,0,12"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}">
                    <Grid>
                        <TextBlock Text="TOTAL" Foreground="White" Opacity="0.9"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Total, Converter={StaticResource Moneda}}"
                                   Foreground="White" HorizontalAlignment="Right"
                                   FontSize="28" FontWeight="Bold" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4">
                    <Button Style="{StaticResource BotonPrincipal}"
                            Height="54" FontSize="15"
                            Command="{Binding CobrarCommand}"
                            ToolTip="Registrar la venta y cobrar">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="COBRAR" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotonTexto}" Margin="0,8,0,0"
                            Command="{Binding VaciarCarritoCommand}"
                            Foreground="{StaticResource BrochaError}"
                            ToolTip="Quitar todos los productos del carrito">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartRemove" VerticalAlignment="Center" />
                            <TextBlock Text="VACIAR CARRITO" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
