<UserControl x:Class="Papeleria.App.Views.Paginas.GastosView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource CampoTexto}"/>
  <Style TargetType="ComboBox" BasedOn="{StaticResource CampoSeleccion}"/>
  <Style TargetType="DatePicker" BasedOn="{StaticResource CampoFecha}"/>
 </UserControl.Resources>
 <Grid Margin="{StaticResource MargenPagina}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="CONTROL FINANCIERO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}"/>
    <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}"/>
   </StackPanel>
   <Button Grid.Column="1" Command="{Binding NuevoCommand}" Style="{StaticResource BotonPrincipal}" VerticalAlignment="Center" Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}">
    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Plus" VerticalAlignment="Center"/><TextBlock Text="Registrar gasto" Margin="8,0,0,0"/></StackPanel>
   </Button>
  </Grid>
  <Grid Grid.Row="1" IsEnabled="{Binding EstaCargando, Converter={StaticResource InvertirBool}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <UniformGrid Columns="3" Margin="0,0,-12,0">
    <md:Card Style="{StaticResource TarjetaBase}" Margin="0,0,12,16">
     <StackPanel><TextBlock Text="Gastos del período" Style="{StaticResource EtiquetaCampo}"/><TextBlock Text="{Binding Total, Converter={StaticResource Moneda}}" Style="{StaticResource ValorDestacado}" Margin="0,8,0,6"/><TextBlock Text="Solo registros vigentes" Style="{StaticResource TextoTenue}"/></StackPanel>
    </md:Card>
    <md:Card Style="{StaticResource TarjetaBase}" Margin="0,0,12,16">
     <StackPanel><TextBlock Text="Pagados en efectivo" Style="{StaticResource EtiquetaCampo}"/><TextBlock Text="{Binding Efectivo, Converter={StaticResource Moneda}}" Style="{StaticResource ValorDestacado}" Margin="0,8,0,6"/><TextBlock Text="Vinculados a movimientos de caja" Style="{StaticResource TextoTenue}"/></StackPanel>
    </md:Card>
    <md:Card Style="{StaticResource TarjetaBase}" Margin="0,0,12,16">
     <StackPanel><TextBlock Text="Otros medios de pago" Style="{StaticResource EtiquetaCampo}"/><TextBlock Text="{Binding OtrosPagos, Converter={StaticResource Moneda}}" Style="{StaticResource ValorDestacado}" Margin="0,8,0,6"/><TextBlock Text="Tarjeta, transferencia y billeteras" Style="{StaticResource TextoTenue}"/></StackPanel>
    </md:Card>
   </UniformGrid>
   <md:Card Grid.Row="1" Style="{StaticResource TarjetaBase}" Padding="16,10">
    <WrapPanel VerticalAlignment="Center">
     <StackPanel Width="245" Margin="0,0,12,8"><TextBlock Text="Concepto, beneficiario o referencia" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Margin="0" MinHeight="40"/></StackPanel>
     <StackPanel Width="132" Margin="0,0,12,8"><TextBlock Text="Desde" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding Desde}" Margin="0" MinHeight="40"/></StackPanel>
     <StackPanel Width="132" Margin="0,0,12,8"><TextBlock Text="Hasta" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding Hasta}" Margin="0" MinHeight="40"/></StackPanel>
     <ComboBox ItemsSource="{Binding CategoriasFiltro}" SelectedItem="{Binding CategoriaFiltro}" Width="175" Margin="0,0,12,8"/>
     <Button Content="Aplicar filtros" Command="{Binding BuscarCommand}" Style="{StaticResource BotonSecundario}" Margin="0,0,8,8"/>
     <Button Content="Este mes" Command="{Binding EsteMesCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,8"/>
     <CheckBox Content="Incluir anulados" IsChecked="{Binding IncluirAnulados}" VerticalAlignment="Center" Margin="0,0,0,8"/>
    </WrapPanel>
   </md:Card>
   <md:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="16" Margin="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="Exportar Excel" Command="{Binding ExportarCommand}" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"/>
       <Button Content="Anular seleccionado" Command="{Binding AnularCommand}" Style="{StaticResource MaterialDesignFlatButton}" Visibility="{Binding PuedeAnular, Converter={StaticResource BoolAVisible}}"/>
      </StackPanel>
      <StackPanel><TextBlock Text="Historial de gastos" Style="{StaticResource TituloSeccion}" Margin="0,0,0,3"/><TextBlock Text="{Binding Resumen}" Style="{StaticResource TextoTenue}"/></StackPanel>
     </DockPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Gastos}" SelectedItem="{Binding Seleccionado}" Style="{StaticResource GrillaDatos}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="105"/>
       <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" MinWidth="160"/>
       <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="135"/>
       <DataGridTextColumn Header="Beneficiario" Binding="{Binding Beneficiario}" Width="140"/>
       <DataGridTextColumn Header="Pago" Binding="{Binding Pago}" Width="110"/>
       <DataGridTextColumn Header="Monto" Binding="{Binding Monto, Converter={StaticResource Moneda}}" ElementStyle="{StaticResource CeldaNumerica}" HeaderStyle="{StaticResource EncabezadoNumerico}" Width="135"/>
       <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding SinResultados, Converter={StaticResource BoolAVisible}}">
      <md:PackIcon Kind="CashMinus" Width="42" Height="42" Opacity="0.4" HorizontalAlignment="Center"/>
      <TextBlock Text="No hay gastos para este período" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,6"/>
      <TextBlock Text="Registra un gasto o ajusta los filtros y pulsa Aplicar filtros." Style="{StaticResource TextoTenue}"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding Seleccionado, Converter={StaticResource NuloAVisible}}">
      <TextBlock Text="{Binding Seleccionado.Referencia, StringFormat=Referencia: {0}}" Style="{StaticResource TextoTenue}"/>
      <TextBlock Text="{Binding Seleccionado.Usuario, StringFormat=Registrado por: {0}}" Style="{StaticResource TextoTenue}"/>
      <TextBlock Text="{Binding Seleccionado.MotivoAnulacion}" TextWrapping="Wrap" Style="{StaticResource TextoTenue}"/>
     </StackPanel>
    </Grid>
   </md:Card>
  </Grid>
  <!-- Formulario superpuesto: mantiene el contexto del listado sin comprimir sus columnas. -->
  <Grid Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}" Visibility="{Binding FormularioAbierto, Converter={StaticResource BoolAVisible}}" IsEnabled="{Binding EstaCargando, Converter={StaticResource InvertirBool}}">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <md:Card Style="{StaticResource TarjetaBase}" MaxWidth="740" HorizontalAlignment="Center" Padding="28">
     <StackPanel>
      <TextBlock Text="Nuevo gasto" Style="{StaticResource TituloPagina}"/>
      <TextBlock Text="Registra pagos operativos. Las compras de mercancía se registran en Compras." TextWrapping="Wrap" Style="{StaticResource SubtituloPagina}" Margin="0,8,0,20"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,16,14"><TextBlock Text="Fecha del gasto *" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding Fecha}" Margin="0" MinHeight="40"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,0,14"><TextBlock Text="Categoría *" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding Categoria}" Margin="0" MinHeight="40"/></StackPanel>
      </Grid>
      <StackPanel Margin="0,0,0,14"><TextBlock Text="Concepto *" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><TextBox Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" Margin="0" MinHeight="40"/></StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,16,14"><TextBlock Text="Valor en pesos (COP) *" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><TextBox Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0" MinHeight="40"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,0,14"><TextBlock Text="Medio de pago *" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding MetodosPago}" SelectedValuePath="Valor" DisplayMemberPath="Descripcion" SelectedValue="{Binding MetodoPago}" Margin="0" MinHeight="40"/></StackPanel>
      </Grid>
      <StackPanel Margin="0,0,0,14"><TextBlock Text="Beneficiario (opcional)" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><TextBox Text="{Binding Beneficiario, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Margin="0" MinHeight="40"/></StackPanel>
      <StackPanel Margin="0,0,0,14"><TextBlock Text="Referencia o número de comprobante (opcional)" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,5"/><TextBox Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0" MinHeight="40"/></StackPanel>
      <Border Background="{DynamicResource BrochaMenuActivo}" CornerRadius="10" Padding="14" Margin="0,0,0,20">
       <TextBlock Text="El efectivo se descuenta del turno de caja abierto al registrar, aunque la fecha del gasto sea anterior. Los demás medios no afectan el cajón." TextWrapping="Wrap"/>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource BotonSecundario}" Margin="0,0,12,0"/>
       <Button Content="Guardar gasto" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrincipal}"/>
      </StackPanel>
     </StackPanel>
    </md:Card>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2">
   <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}"/>
   <TextBlock Text="{Binding MensajeError}" Foreground="{DynamicResource BrochaError}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}"/>
  </StackPanel>
 </Grid>
</UserControl>
