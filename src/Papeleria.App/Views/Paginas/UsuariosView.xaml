<UserControl x:Class="Papeleria.App.Views.Paginas.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:UsuariosVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1340">

    <UserControl.Resources>
        <!--
            El rol decide qué puede hacer cada quien, así que se distingue por color
            en vez de quedar como una palabra más dentro de la fila.
        -->
        <Style x:Key="ChipRol" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#EDE7F6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rol}" Value="Cajero">
                    <Setter Property="Background" Value="#E0F7FA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rol}" Value="Bodega">
                    <Setter Property="Background" Value="#FFF3E0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoChipRol" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5E35B1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rol}" Value="Cajero">
                    <Setter Property="Foreground" Value="#00838F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rol}" Value="Bodega">
                    <Setter Property="Foreground" Value="#EF6C00" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding CambiarMiContrasenaCommand}"
                        ToolTip="Cambiar la contraseña de su propio usuario">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockReset" VerticalAlignment="Center" />
                        <TextBlock Text="Mi contraseña" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonPrincipal}"
                        Command="{Binding NuevoCommand}"
                        Visibility="{Binding PuedeCrear, Converter={StaticResource BoolAVisible}}"
                        ToolTip="Crear un usuario nuevo">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlusOutline" VerticalAlignment="Center" />
                        <TextBlock Text="NUEVO USUARIO" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ══ Usuarios ════════════════════════════════════════════════ -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,14,16,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Operadores del sistema" Style="{StaticResource TituloSeccion}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />

                            <Border Style="{StaticResource ContadorLista}">
                                <TextBlock Text="{Binding Usuarios.Count}" FontSize="11"
                                           FontWeight="SemiBold" Opacity="0.75" />
                            </Border>
                        </StackPanel>

                        <TextBox Style="{StaticResource CampoBusqueda}"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 materialDesign:HintAssist.Hint="Buscar por nombre, usuario o correo"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" Style="{StaticResource GrillaDatos}"
                              ItemsSource="{Binding UsuariosFiltrados}"
                              SelectedItem="{Binding UsuarioSeleccionado}"
                              RowHeight="56">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditarCommand}" />
                        </DataGrid.InputBindings>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Usuario" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16"
                                                    Background="{DynamicResource MaterialDesign.Brush.Primary.Light}">
                                                <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                                         Width="18" Height="18"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light.Foreground}" />
                                            </Border>

                                            <StackPanel Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding NombreCompleto}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <materialDesign:PackIcon Kind="ShieldCrownOutline"
                                                                             Width="14" Height="14"
                                                                             Margin="6,0,0,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{StaticResource BrochaAdvertencia}"
                                                                             ToolTip="Administrador principal: no puede eliminarse"
                                                                             Visibility="{Binding EsProtegido, Converter={StaticResource BoolAVisible}}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource TextoTenue}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding NombreUsuario, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Correo, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Rol" Width="118" SortMemberPath="Rol">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipRol}">
                                            <TextBlock Style="{StaticResource TextoChipRol}"
                                                       Text="{Binding Rol, Converter={StaticResource EnumADescripcion}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Fecha y hora en dos renglones: en una sola línea se cortaba. -->
                            <DataGridTemplateColumn Header="Último acceso" Width="115" SortMemberPath="UltimoAcceso">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UltimoAcceso, Converter={StaticResource Fecha}}"
                                                       FontSize="12.5" />
                                            <TextBlock Text="{Binding UltimoAcceso, StringFormat=HH:mm}"
                                                       Style="{StaticResource TextoTenue}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Estado" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipEstado}">
                                            <TextBlock Style="{StaticResource TextoChipEstado}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="150" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource BotonIconoAccion}"
                                                    Command="{Binding DataContext.RestablecerContrasenaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="Asignar una contraseña nueva a este usuario">
                                                <materialDesign:PackIcon Kind="LockReset" Width="17" Height="17" />
                                            </Button>
                                            <Button Style="{StaticResource BotonIconoAccion}"
                                                    Command="{Binding DataContext.EditarCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="Editar el usuario">
                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                         Width="17" Height="17" />
                                            </Button>
                                            <Button Style="{StaticResource BotonIconoAccion}"
                                                    Command="{Binding DataContext.AlternarEstadoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}"
                                                    ToolTip="Activar o desactivar">
                                                <materialDesign:PackIcon Kind="PowerStandby"
                                                                         Width="17" Height="17" />
                                            </Button>
                                            <Button Style="{StaticResource BotonIconoAccion}"
                                                    Command="{Binding DataContext.EliminarCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}"
                                                    Foreground="{StaticResource BrochaError}"
                                                    ToolTip="Eliminar el usuario">
                                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                                         Width="17" Height="17" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- ══ Matriz de permisos ══════════════════════════════════════ -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,14,16,8">
                        <TextBlock Text="Permisos por rol" Style="{StaticResource TituloSeccion}"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="El rol Administrador siempre conserva acceso total y no se puede restringir."
                                   Style="{StaticResource TextoTenue}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedValue="{Binding RolPermisos}"
                                  SelectedValuePath="Valor" DisplayMemberPath="Descripcion"
                                  Style="{StaticResource CampoSeleccion}"
                                  Margin="0"
                                  materialDesign:HintAssist.Hint="Rol a configurar"
                                  materialDesign:HintAssist.IsFloating="True" />
                    </StackPanel>

                    <!-- Las bandas alternas ayudan a no perder la fila al marcar casillas. -->
                    <DataGrid Grid.Row="1" Style="{StaticResource GrillaEditable}"
                              ItemsSource="{Binding Permisos}"
                              RowHeight="40" CanUserSortColumns="False"
                              AlternationCount="2"
                              AlternatingRowBackground="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Módulo" Binding="{Binding NombreModulo}"
                                                Width="*" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Ver" Binding="{Binding PuedeVer}" Width="52" />
                            <DataGridCheckBoxColumn Header="Crear" Binding="{Binding PuedeCrear}" Width="58" />
                            <DataGridCheckBoxColumn Header="Editar" Binding="{Binding PuedeEditar}" Width="62" />
                            <DataGridCheckBoxColumn Header="Borrar" Binding="{Binding PuedeEliminar}" Width="62" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Style="{StaticResource BotonPrincipal}"
                            Margin="16,12,16,16" Height="40"
                            Command="{Binding GuardarPermisosCommand}"
                            Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheckOutline" VerticalAlignment="Center" />
                            <TextBlock Text="GUARDAR PERMISOS" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
