<UserControl x:Class="Papeleria.App.Views.Paginas.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:ConfiguracionVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1340">

    <UserControl.Resources>
        <!--
            Navegación de ajustes en vertical, como cualquier panel de configuración:
            la franja de pestañas horizontal ocupaba todo el ancho para cuatro
            palabras y dejaba el formulario en una columna estrecha.
        -->
        <Style x:Key="SeccionAjustes" TargetType="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Fondo" Background="Transparent"
                                CornerRadius="8" Margin="8,2" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Marca" Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="Transparent" Margin="-6,2,0,2" />

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" Margin="9,0,0,0" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background"
                                        Value="{DynamicResource MaterialDesignChipBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fondo" Property="Background"
                                        Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                <Setter TargetName="Marca" Property="Background"
                                        Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
            <TabControl TabStripPlacement="Left"
                        BorderThickness="0"
                        Padding="0"
                        ItemContainerStyle="{StaticResource SeccionAjustes}">

                <!-- ══ Empresa ═════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Width="184">
                            <materialDesign:PackIcon Kind="StoreOutline" VerticalAlignment="Center" />
                            <TextBlock Text="Empresa" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Width="700">
                                <TextBlock Text="Datos que aparecen en facturas, etiquetas y reportes"
                                           Style="{StaticResource TituloSeccion}" />

                                <TextBox Style="{StaticResource CampoTexto}" MaxLength="150"
                                         Text="{Binding NombreEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Nombre comercial"
                                         materialDesign:HintAssist.IsFloating="True" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}" MaxLength="40"
                                             Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="NIT o documento"
                                             materialDesign:HintAssist.IsFloating="True" />

                                    <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}" MaxLength="40"
                                             Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Teléfono"
                                             materialDesign:HintAssist.IsFloating="True" />
                                </Grid>

                                <TextBox Style="{StaticResource CampoTexto}" MaxLength="250"
                                         Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Dirección"
                                         materialDesign:HintAssist.IsFloating="True" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}" MaxLength="100"
                                             Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Ciudad"
                                             materialDesign:HintAssist.IsFloating="True" />

                                    <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}" MaxLength="150"
                                             Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Correo electrónico"
                                             materialDesign:HintAssist.IsFloating="True" />
                                </Grid>

                                <TextBox Style="{StaticResource CampoTexto}" MaxLength="150"
                                         Text="{Binding Eslogan, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Eslogan (opcional)"
                                         materialDesign:HintAssist.IsFloating="True" />

                                <Separator Style="{StaticResource SeparadorHorizontal}" />

                                <TextBlock Text="Impuestos y moneda" Style="{StaticResource TituloSeccion}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Style="{StaticResource CampoNumerico}"
                                             Text="{Binding IvaPorDefecto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             materialDesign:HintAssist.Hint="IVA por defecto (%)"
                                             materialDesign:HintAssist.IsFloating="True" />

                                    <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}" MaxLength="5"
                                             Text="{Binding MonedaSimbolo, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Símbolo"
                                             materialDesign:HintAssist.IsFloating="True" />

                                    <TextBox Grid.Column="4" Style="{StaticResource CampoTexto}" MaxLength="5"
                                             Text="{Binding MonedaCodigo, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Código ISO"
                                             materialDesign:HintAssist.IsFloating="True" />

                                    <TextBox Grid.Column="6" Style="{StaticResource CampoNumerico}"
                                             Text="{Binding DecimalesMoneda, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Decimales"
                                             materialDesign:HintAssist.IsFloating="True" />
                                </Grid>

                                <Separator Style="{StaticResource SeparadorHorizontal}" />

                                <TextBlock Text="Texto de la factura" Style="{StaticResource TituloSeccion}" />

                                <TextBox Style="{StaticResource CampoTexto}" MaxLength="300"
                                         Text="{Binding ResolucionFactura, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Resolución de facturación (opcional)"
                                         materialDesign:HintAssist.IsFloating="True" />

                                <TextBox Style="{StaticResource CampoTexto}" MaxLength="200"
                                         Text="{Binding PieFactura, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Mensaje al pie del recibo"
                                         materialDesign:HintAssist.IsFloating="True" />

                                <Button Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left"
                                        Command="{Binding GuardarEmpresaCommand}"
                                        IsEnabled="{Binding PuedeEditar}" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" />
                                        <TextBlock Text="GUARDAR DATOS DE LA EMPRESA" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Logo y apariencia -->
                            <StackPanel Grid.Column="2" Width="280" HorizontalAlignment="Left">
                                <TextBlock Text="Logotipo" Style="{StaticResource TituloSeccion}" />

                                <Border Height="170" CornerRadius="8" Margin="0,0,0,10"
                                        BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        Background="{DynamicResource MaterialDesignChipBackground}">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center"
                                                    Visibility="{Binding LogoPath, Converter={StaticResource TextoAVisible}, ConverterParameter=Invertir}">
                                            <materialDesign:PackIcon Kind="ImageOutline" Width="40" Height="40"
                                                                     Opacity="0.3" HorizontalAlignment="Center" />
                                            <TextBlock Text="Sin logotipo" Style="{StaticResource TextoTenue}"
                                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                                        </StackPanel>

                                        <Image Source="{Binding LogoPath, Converter={StaticResource RutaAImagen}}"
                                               Stretch="Uniform" Margin="12" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                            Command="{Binding SeleccionarLogoCommand}"
                                            IsEnabled="{Binding PuedeEditar}" Content="Cambiar" />

                                    <Button Style="{StaticResource BotonTexto}"
                                            Command="{Binding QuitarLogoCommand}"
                                            IsEnabled="{Binding PuedeEditar}"
                                            Foreground="{StaticResource BrochaError}" Content="Quitar" />
                                </StackPanel>

                                <Separator Style="{StaticResource SeparadorHorizontal}" />

                                <TextBlock Text="Apariencia" Style="{StaticResource TituloSeccion}" />

                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              IsChecked="{Binding TemaOscuro}"
                                              Command="{Binding AlternarTemaCommand}"
                                              HorizontalAlignment="Left"
                                              ToolTip="Activar el tema oscuro" />

                                <TextBlock Text="Tema oscuro" Style="{StaticResource TextoTenue}"
                                           Margin="0,6,0,0" />

                                <Separator Style="{StaticResource SeparadorHorizontal}" />

                                <TextBlock Text="Ubicación de los datos" Style="{StaticResource TituloSeccion}" />

                                <TextBlock Text="{Binding RutaBaseDatos}" Style="{StaticResource TextoTenue}"
                                           FontSize="10.5" TextWrapping="Wrap" />

                                <Button Style="{StaticResource BotonTexto}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" FontSize="11"
                                        Command="{Binding AbrirCarpetaLogsCommand}"
                                        Content="Ver registro de errores" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ══ Numeración ══════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Width="184">
                            <materialDesign:PackIcon Kind="Numeric" VerticalAlignment="Center" />
                            <TextBlock Text="Numeración" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel Margin="20" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Consecutivos de documentos" Style="{StaticResource TituloSeccion}" />

                        <Border Background="{StaticResource BrochaInformacionSuave}"
                                CornerRadius="6" Padding="12,9" Margin="0,0,0,16">
                            <TextBlock Text="Los consecutivos solo pueden aumentar. Reducirlos generaría documentos con números repetidos."
                                       Foreground="{StaticResource BrochaInformacion}"
                                       TextWrapping="Wrap" FontSize="12.5" />
                        </Border>

                        <TextBlock Text="Facturas de venta" Style="{StaticResource EtiquetaCampo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}" MaxLength="10"
                                     Text="{Binding PrefijoFactura, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Prefijo (por ejemplo FV-)"
                                     materialDesign:HintAssist.IsFloating="True" />

                            <TextBox Grid.Column="2" Style="{StaticResource CampoNumerico}"
                                     Text="{Binding ConsecutivoFactura, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Último número emitido"
                                     materialDesign:HintAssist.IsFloating="True" />
                        </Grid>

                        <TextBlock Text="Compras" Style="{StaticResource EtiquetaCampo}" Margin="0,10,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}" MaxLength="10"
                                     Text="{Binding PrefijoCompra, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Prefijo (por ejemplo CMP-)"
                                     materialDesign:HintAssist.IsFloating="True" />

                            <TextBox Grid.Column="2" Style="{StaticResource CampoNumerico}"
                                     Text="{Binding ConsecutivoCompra, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Último número registrado"
                                     materialDesign:HintAssist.IsFloating="True" />
                        </Grid>

                        <Button Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left"
                                Command="{Binding GuardarNumeracionCommand}"
                                IsEnabled="{Binding PuedeEditar}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" />
                                <TextBlock Text="GUARDAR NUMERACIÓN" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </TabItem>

                <!-- ══ Actualizaciones ═════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Width="184">
                            <materialDesign:PackIcon Kind="CloudDownloadOutline" VerticalAlignment="Center" />
                            <TextBlock Text="Actualizaciones" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel Margin="20" MaxWidth="680" HorizontalAlignment="Left">
                        <!-- Versión instalada -->
                        <Border CornerRadius="10" Padding="16,13" Margin="0,0,0,18"
                                Background="{DynamicResource MaterialDesignChipBackground}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Versión instalada" Style="{StaticResource EtiquetaCampo}" />
                                    <TextBlock Text="{Binding VersionInstalada}"
                                               FontSize="22" FontWeight="Bold" />
                                    <TextBlock Style="{StaticResource TextoTenue}" FontSize="11.5" Margin="0,2,0,0">
                                        <Run Text="Última comprobación:" />
                                        <Run Text="{Binding UltimaComprobacion, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <Button Style="{StaticResource BotonPrincipal}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding BuscarActualizacionesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                                        <TextBlock Text="BUSCAR AHORA" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Aviso cuando el equipo no puede autoactualizarse -->
                        <Border Background="{StaticResource BrochaAdvertenciaSuave}"
                                CornerRadius="8" Padding="13,10" Margin="0,0,0,18"
                                Visibility="{Binding MensajeImpedimento, Converter={StaticResource TextoAVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOutline"
                                                         Foreground="{StaticResource BrochaAdvertencia}"
                                                         VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding MensajeImpedimento}"
                                           Foreground="{StaticResource BrochaAdvertencia}"
                                           TextWrapping="Wrap" MaxWidth="580" FontSize="12.5" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Origen de las actualizaciones"
                                   Style="{StaticResource TituloSeccion}" />

                        <TextBlock Text="Repositorio de GitHub donde se publican las versiones nuevas. Al publicar una release con el ejecutable adjunto, el programa la detecta y ofrece instalarla."
                                   Style="{StaticResource TextoTenue}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBox Style="{StaticResource CampoTexto}" MaxLength="200"
                                 Text="{Binding RepositorioActualizaciones, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="usuario/repositorio  (por ejemplo: joeldearcos/papeleria)"
                                 materialDesign:HintAssist.IsFloating="True" />

                        <CheckBox Content="Comprobar automáticamente al iniciar (como mucho una vez al día)"
                                  IsChecked="{Binding ActualizacionesAutomaticas}"
                                  Margin="0,0,0,18" />

                        <Button Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left"
                                Command="{Binding GuardarActualizacionesCommand}"
                                IsEnabled="{Binding PuedeEditar}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" />
                                <TextBlock Text="GUARDAR AJUSTES" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource SeparadorHorizontal}" />

                        <Border Background="{StaticResource BrochaInformacionSuave}"
                                CornerRadius="8" Padding="14,11">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline"
                                                             Foreground="{StaticResource BrochaInformacion}"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Cómo funciona la actualización"
                                               Foreground="{StaticResource BrochaInformacion}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Foreground="{StaticResource BrochaInformacion}"
                                           TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                                           Text="La descarga se verifica con su huella SHA-256 antes de instalarse, así que un archivo incompleto o alterado se descarta. El ejecutable anterior se conserva hasta el siguiente arranque por si hiciera falta volver atrás, y sus datos, respaldos y configuración no se tocan en ningún momento." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ══ Copias de seguridad ═════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Width="184">
                            <materialDesign:PackIcon Kind="DatabaseCogOutline" VerticalAlignment="Center" />
                            <TextBlock Text="Copias de seguridad" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Configuración" Style="{StaticResource TituloSeccion}" />

                            <TextBox Style="{StaticResource CampoTexto}"
                                     Text="{Binding CarpetaRespaldos, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Carpeta de destino"
                                     materialDesign:HintAssist.IsFloating="True" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                        Command="{Binding SeleccionarCarpetaRespaldosCommand}"
                                        Content="Elegir carpeta" />

                                <Button Style="{StaticResource BotonTexto}"
                                        Command="{Binding AbrirCarpetaRespaldosCommand}"
                                        Content="Abrir carpeta" />
                            </StackPanel>

                            <CheckBox Content="Crear una copia automática al cerrar la aplicación"
                                      IsChecked="{Binding RespaldoAutomatico}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Style="{StaticResource CampoNumerico}"
                                         Text="{Binding FrecuenciaRespaldoDias, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Días entre copias"
                                         materialDesign:HintAssist.IsFloating="True" />

                                <TextBox Grid.Column="2" Style="{StaticResource CampoNumerico}"
                                         Text="{Binding RetencionRespaldos, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Copias a conservar"
                                         materialDesign:HintAssist.IsFloating="True" />
                            </Grid>

                            <Button Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left"
                                    Command="{Binding GuardarConfiguracionRespaldoCommand}"
                                    IsEnabled="{Binding PuedeEditar}"
                                    Content="Guardar configuración" Margin="0,0,0,16" />

                            <Separator Style="{StaticResource SeparadorHorizontal}" />

                            <Button Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left"
                                    Command="{Binding CrearRespaldoCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseArrowDownOutline"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="CREAR COPIA AHORA" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Copias disponibles" Style="{StaticResource TituloSeccion}"
                                           Margin="0" VerticalAlignment="Center" />

                                <Button Style="{StaticResource BotonIconoAccion}" HorizontalAlignment="Right"
                                        Command="{Binding ActualizarRespaldosCommand}"
                                        ToolTip="Volver a leer la carpeta">
                                    <materialDesign:PackIcon Kind="Refresh" />
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}" CornerRadius="8">
                                <Grid>
                                    <DataGrid Style="{StaticResource GrillaDatos}"
                                              ItemsSource="{Binding Respaldos}"
                                              SelectedItem="{Binding RespaldoSeleccionado}"
                                              RowHeight="40">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Archivo" Binding="{Binding Nombre}"
                                                                Width="*" />
                                            <DataGridTextColumn Header="Fecha" Width="145"
                                                                Binding="{Binding Fecha, Converter={StaticResource Fecha}, ConverterParameter=Hora}" />
                                            <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoTexto}"
                                                                Width="95"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding Respaldos.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                                        <materialDesign:PackIcon Kind="DatabaseOffOutline" Width="44" Height="44"
                                                                 Opacity="0.25" HorizontalAlignment="Center" />
                                        <TextBlock Text="Todavía no hay copias de seguridad en esta carpeta"
                                                   Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                        Visibility="{Binding EsAdministrador, Converter={StaticResource BoolAVisible}}">
                                <Border Background="{StaticResource BrochaAdvertenciaSuave}"
                                        CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
                                    <TextBlock Text="Restaurar reemplaza todos los datos actuales. Antes se guarda automáticamente una copia del estado vigente y la aplicación se cerrará al terminar."
                                               Foreground="{StaticResource BrochaAdvertencia}"
                                               TextWrapping="Wrap" FontSize="12" />
                                </Border>

                                <Button Style="{StaticResource BotonPeligro}" HorizontalAlignment="Left"
                                        Command="{Binding RestaurarRespaldoCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseRefreshOutline"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="RESTAURAR LA COPIA SELECCIONADA" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>
