<UserControl x:Class="Papeleria.App.Views.Paginas.HistorialVentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Paginas"
             d:DataContext="{d:DesignInstance vm:HistorialVentasVistaModelo}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1360">

    <UserControl.Resources>
        <!-- Botón de rango: se resalta el periodo activo. -->
        <Style x:Key="BotonRango" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        </Style>

        <Style x:Key="BotonRangoActivo" TargetType="Button" BasedOn="{StaticResource BotonRango}">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Encabezado ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding ExportarExcelCommand}" ToolTip="Exportar a Excel">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center" />
                        <TextBlock Text="Excel" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                        Command="{Binding ExportarPdfCommand}" ToolTip="Exportar a PDF">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" />
                        <TextBlock Text="PDF" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotonIconoAccion}"
                        Command="{Binding ActualizarCommand}" ToolTip="Actualizar el listado">
                    <materialDesign:PackIcon Kind="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ Resumen del periodo ═════════════════════════════════════════ -->
        <!-- Mismas tarjetas que el panel principal: la cifra primero y el icono como acento. -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-14,0">
            <controls:TarjetaMetrica
                Icono="CashRegister"
                FondoIcono="#E1F5FE"
                ColorIcono="#0277BD"
                Etiqueta="{Binding DescripcionPeriodo}"
                Valor="{Binding Resumen.TotalFacturado, Converter={StaticResource Moneda}}">
                <controls:TarjetaMetrica.Pie>
                    <TextBlock Style="{StaticResource TextoTenue}" FontSize="11.5">
                        <Run Text="{Binding Resumen.CantidadFacturas, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="factura(s) cobrada(s)" />
                    </TextBlock>
                </controls:TarjetaMetrica.Pie>
            </controls:TarjetaMetrica>

            <controls:TarjetaMetrica
                Icono="ReceiptTextOutline"
                FondoIcono="#EDE7F6"
                ColorIcono="#5E35B1"
                Etiqueta="Ticket promedio"
                Valor="{Binding Resumen.TicketPromedio, Converter={StaticResource Moneda}}"
                Nota="por factura del periodo" />

            <controls:TarjetaMetrica
                Icono="TrendingUp"
                FondoIcono="#E8F5E9"
                ColorIcono="#2E7D32"
                Etiqueta="Utilidad bruta"
                Valor="{Binding Resumen.TotalUtilidad, Converter={StaticResource Moneda}}">
                <controls:TarjetaMetrica.Pie>
                    <TextBlock Style="{StaticResource TextoTenue}" FontSize="11.5">
                        <Run Text="margen" />
                        <Run Text="{Binding Resumen.MargenPorcentaje, Converter={StaticResource Porcentaje}, Mode=OneWay}" />
                    </TextBlock>
                </controls:TarjetaMetrica.Pie>
            </controls:TarjetaMetrica>

            <!-- Solo aparece si hay facturas anuladas en el periodo -->
            <controls:TarjetaMetrica
                Icono="CloseCircleOutline"
                FondoIcono="#FFEBEE"
                ColorIcono="#C62828"
                Etiqueta="Anuladas"
                Valor="{Binding Resumen.CantidadAnuladas}"
                Nota="{Binding Resumen.TotalAnulado, Converter={StaticResource Moneda}}"
                EsAlerta="True"
                Visibility="{Binding Resumen.HayAnuladas, Converter={StaticResource BoolAVisible}}" />
        </UniformGrid>

        <!-- ══ Filtros ═════════════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource TarjetaBase}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Accesos rápidos al periodo -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Command="{Binding VerHoyCommand}" Content="Hoy">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonRango}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsRangoHoy}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding VerAyerCommand}" Content="Ayer">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonRango}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsRangoAyer}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding VerSemanaCommand}" Content="Últimos 7 días">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonRango}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsRangoSemana}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding VerMesCommand}" Content="Este mes">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonRango}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsRangoMes}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource CampoBusqueda}"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             materialDesign:HintAssist.Hint="Buscar por número de factura, cliente o documento"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                    <DatePicker Grid.Column="2" Style="{StaticResource FiltroFecha}" SelectedDate="{Binding Desde}"
                                materialDesign:HintAssist.Hint="Desde" VerticalContentAlignment="Center" />

                    <DatePicker Grid.Column="4" Style="{StaticResource FiltroFecha}" SelectedDate="{Binding Hasta}"
                                materialDesign:HintAssist.Hint="Hasta" VerticalContentAlignment="Center" />

                    <ComboBox Grid.Column="6" Style="{StaticResource FiltroSeleccion}"
                              materialDesign:HintAssist.Hint="Cliente"
                              ItemsSource="{Binding Clientes}"
                              SelectedValue="{Binding ClienteId}"
                              SelectedValuePath="Id" DisplayMemberPath="Nombre"
                              VerticalContentAlignment="Center" ToolTip="Filtrar por cliente" />

                    <ComboBox Grid.Column="8" Style="{StaticResource FiltroSeleccion}"
                              materialDesign:HintAssist.Hint="Medio de pago"
                              ItemsSource="{Binding MetodosPago}"
                              SelectedValue="{Binding MetodoPago}"
                              SelectedValuePath="Key" DisplayMemberPath="Value"
                              VerticalContentAlignment="Center" ToolTip="Filtrar por medio de pago" />

                    <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Incluir anuladas" IsChecked="{Binding IncluirAnuladas}"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />

                        <Button Style="{StaticResource BotonIconoAccion}"
                                Command="{Binding LimpiarFiltrosCommand}"
                                ToolTip="Volver a las ventas de hoy">
                            <materialDesign:PackIcon Kind="FilterRemoveOutline" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <Border Grid.Row="3" Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <!-- ══ Listado y detalle ═══════════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.9*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Style="{StaticResource TarjetaBase}" Padding="0" Margin="0">
                    <Grid>
                        <DataGrid Style="{StaticResource GrillaDatos}"
                                  ItemsSource="{Binding Ventas}"
                                  SelectedItem="{Binding VentaSeleccionada}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Style.Triggers>
                                        <!-- Las anuladas se atenúan para distinguirlas de un vistazo -->
                                        <DataTrigger Binding="{Binding EstaAnulada}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Factura" Binding="{Binding NumeroFactura}" Width="120" />

                                <DataGridTemplateColumn Header="Fecha y hora" Width="160" SortMemberPath="Fecha">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Fecha, Converter={StaticResource Fecha}}"
                                                           FontSize="12.5" />
                                                <TextBlock Text="{Binding Fecha, Converter={StaticResource Fecha}, ConverterParameter=SoloHora}"
                                                           Style="{StaticResource TextoTenue}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" />
                                <DataGridTextColumn Header="Cajero" Binding="{Binding UsuarioNombre}" Width="150" />
                                <DataGridTextColumn Header="Pago" Binding="{Binding MetodoPagoTexto}" Width="110" />

                                <DataGridTextColumn Header="Ítems" Binding="{Binding CantidadItems}" Width="65"
                                            ElementStyle="{StaticResource CeldaNumerica}"
                                            HeaderStyle="{StaticResource EncabezadoNumerico}" />

                                <DataGridTextColumn Header="Total" Width="120"
                                                    Binding="{Binding Total, Converter={StaticResource Moneda}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Estado" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Distintivo}">
                                                        <Setter Property="Background" Value="#43A047" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstaAnulada}" Value="True">
                                                                <Setter Property="Background" Value="#E53935" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EstadoTexto}"
                                                           Style="{StaticResource TextoDistintivo}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Ventas.Count, Converter={StaticResource ColeccionVaciaAVisible}}">
                            <materialDesign:PackIcon Kind="ReceiptTextRemoveOutline" Width="52" Height="52"
                                                     Opacity="0.25" HorizontalAlignment="Center" />
                            <TextBlock Text="No hay ventas registradas en este periodo"
                                       Style="{StaticResource TextoTenue}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="40" Height="40"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}" />
                    </Grid>
                </materialDesign:Card>

                <controls:PaginadorView Grid.Row="1" DataContext="{Binding Paginador}" />
            </Grid>

            <!-- ══ Detalle de la factura ═══════════════════════════════════ -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource TarjetaBase}" Margin="0" Padding="0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="46" Height="46"
                                                 Opacity="0.25" HorizontalAlignment="Center" />
                        <TextBlock Text="Seleccione una factura para ver su detalle y reimprimirla"
                                   Style="{StaticResource TextoTenue}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <Grid Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la factura -->
                        <Border Grid.Row="0" Padding="18,16,18,14"
                                Background="{DynamicResource MaterialDesignChipBackground}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Detalle.NumeroFactura}"
                                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                               FontWeight="Bold" />

                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding VentaSeleccionada.EstaAnulada, Converter={StaticResource BoolAVisible}}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Distintivo}">
                                                <Setter Property="Background" Value="#E53935" />
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ANULADA" Style="{StaticResource TextoDistintivo}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Detalle.Fecha, Converter={StaticResource Fecha}, ConverterParameter=Hora}"
                                           Style="{StaticResource TextoTenue}" FontSize="11.5" Margin="0,2,0,0" />

                                <Separator Style="{StaticResource SeparadorHorizontal}" Margin="0,10" />

                                <StackPanel Style="{StaticResource FilaContacto}">
                                    <materialDesign:PackIcon Kind="AccountOutline"
                                                             Style="{StaticResource IconoContacto}" />
                                    <TextBlock Text="{Binding Detalle.ClienteNombre}"
                                               Style="{StaticResource TextoContacto}" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FilaContacto}">
                                    <materialDesign:PackIcon Kind="CashRegister"
                                                             Style="{StaticResource IconoContacto}" />
                                    <TextBlock Style="{StaticResource TextoContacto}">
                                        <Run Text="{Binding Detalle.UsuarioNombre, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding VentaSeleccionada.MetodoPagoTexto, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Líneas de la factura -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12,18,0">
                            <ItemsControl ItemsSource="{Binding Detalle.Lineas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Descripcion}" FontSize="12.5"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource TextoTenue}" FontSize="11">
                                                    <Run Text="{Binding Cantidad, Converter={StaticResource Cantidad}, Mode=OneWay}" />
                                                    <Run Text="×" />
                                                    <Run Text="{Binding ValorUnitario, Converter={StaticResource Moneda}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Total, Converter={StaticResource Moneda}}"
                                                       FontWeight="SemiBold" FontSize="12.5"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Totales -->
                        <StackPanel Grid.Row="2" Margin="18,10,18,0">
                            <Separator Style="{StaticResource SeparadorHorizontal}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Subtotal" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding Detalle.Subtotal, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>

                            <Grid Margin="0,0,0,5"
                                  Visibility="{Binding Detalle.TotalDescuento, Converter={StaticResource MayorQueCeroAVisible}}">
                                <TextBlock Text="Descuentos" Style="{StaticResource TextoTenue}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12.5"
                                           Foreground="{StaticResource BrochaError}">
                                    <Run Text="-" />
                                    <Run Text="{Binding Detalle.TotalDescuento, Converter={StaticResource Moneda}, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="IVA" Style="{StaticResource TextoTenue}" />
                                <TextBlock Text="{Binding Detalle.TotalIva, Converter={StaticResource Moneda}}"
                                           HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>

                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,1,0,0" Padding="0,9,0,0">
                                <Grid>
                                    <TextBlock Text="TOTAL" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detalle.Total, Converter={StaticResource Moneda}}"
                                               HorizontalAlignment="Right" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </Grid>
                            </Border>

                            <!-- Motivo de anulación, cuando la hay -->
                            <Border Background="{StaticResource BrochaErrorSuave}"
                                    CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                                    Visibility="{Binding Detalle.MotivoAnulacion, Converter={StaticResource TextoAVisible}}">
                                <StackPanel>
                                    <TextBlock Text="Motivo de la anulación" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrochaError}" />
                                    <TextBlock Text="{Binding Detalle.MotivoAnulacion}"
                                               Foreground="{StaticResource BrochaError}"
                                               TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Acciones -->
                        <StackPanel Grid.Row="3" Margin="18,14,18,18">
                            <Button Style="{StaticResource BotonPrincipal}" Height="42"
                                    Command="{Binding ReimprimirReciboCommand}"
                                    ToolTip="Volver a imprimir el recibo de 80 mm">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PrinterOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="REIMPRIMIR RECIBO" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource BotonSecundario}"
                                        MinWidth="0"
                                        Command="{Binding ImprimirCartaCommand}"
                                        ToolTip="Generar la factura en tamaño carta">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Carta" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Style="{StaticResource BotonSecundario}"
                                        MinWidth="0"
                                        Foreground="{StaticResource BrochaError}"
                                        Command="{Binding AnularVentaCommand}"
                                        Visibility="{Binding PuedeAnular, Converter={StaticResource BoolAVisible}}"
                                        IsEnabled="{Binding VentaSeleccionada.EstaAnulada, Converter={StaticResource InvertirBool}}"
                                        ToolTip="Anular la factura y devolver la mercancía al inventario">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Anular" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
