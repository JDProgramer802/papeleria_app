<Window x:Class="Papeleria.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Papeleria.App.ViewModels"
        xmlns:infra="clr-namespace:Papeleria.App.Infrastructure"
        d:DataContext="{d:DesignInstance vm:MainVistaModelo}"
        mc:Ignorable="d"
        Title="Sistema de Gestión de Papelería"
        Height="820" Width="1440"
        MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Papeleria;component/Resources/Images/app.ico"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="{x:Static infra:ServicioDialogos.HostRaiz}"
                               DialogTheme="Inherit"
                               SnackbarMessageQueue="{Binding ColaMensajes}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════ MENÚ LATERAL ══════════════════════════════ -->
            <Border Grid.Column="0"
                    Width="{Binding MenuColapsado, Converter={StaticResource MenuColapsadoAAncho}}"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del menú -->
                    <Grid Grid.Row="0" Height="{StaticResource AlturaBarraSuperior}" Margin="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="{Binding MenuColapsado,
                                                          Converter={StaticResource MenuColapsadoAAlineacion}}"
                                    Margin="{Binding MenuColapsado, Converter={StaticResource MenuColapsadoAMargenCabecera}}">
                            <Grid Width="{Binding MenuColapsado, Converter={StaticResource MenuColapsadoATamanoLogo}}"
                                  Height="{Binding MenuColapsado, Converter={StaticResource MenuColapsadoATamanoLogo}}"
                                  ToolTip="{Binding NombreEmpresa}">
                                <!-- Marca por defecto mientras no se cargue un logotipo -->
                                <Border CornerRadius="10"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Visibility="{Binding TieneLogo, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                                    <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                             Width="22" Height="22"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>

                                <!-- Logotipo cargado en Configuración → Empresa.
                                     Se muestra completo (Uniform) para no recortar
                                     logos apaisados, sobre un fondo neutro que
                                     funciona tanto en tema claro como oscuro. -->
                                <Border CornerRadius="10" Padding="2"
                                        Background="{DynamicResource MaterialDesignChipBackground}"
                                        Visibility="{Binding TieneLogo, Converter={StaticResource BoolAVisible}}">
                                    <Image Source="{Binding LogoEmpresa, Converter={StaticResource RutaAImagen}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding NombreEmpresa}"
                                       FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="150"
                                       Visibility="{Binding MenuColapsado, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}" />
                        </StackPanel>
                    </Grid>

                    <!-- Módulos -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,6,0,6">
                        <ItemsControl ItemsSource="{Binding Menu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ElementoMenu}">
                                    <!--
                                        Plegado, el rótulo emergente es la única etiqueta que
                                        tiene el icono: aparece pronto y al lado, no encima.
                                    -->
                                    <RadioButton Style="{StaticResource BotonMenuLateral}"
                                                 IsChecked="{Binding EstaSeleccionado, Mode=OneWay}"
                                                 ToolTipService.Placement="Right"
                                                 ToolTipService.InitialShowDelay="220"
                                                 ToolTipService.HorizontalOffset="6"
                                                 Command="{Binding DataContext.NavegarCommand,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding Modulo}">
                                        <RadioButton.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Descripcion}" Opacity="0.75" />
                                                </StackPanel>
                                            </ToolTip>
                                        </RadioButton.ToolTip>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="{Binding DataContext.MenuColapsado,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                          Converter={StaticResource MenuColapsadoAAlineacion}}">
                                            <materialDesign:PackIcon Kind="{Binding Icono}"
                                                                     Width="21" Height="21"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Titulo}"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DataContext.MenuColapsado,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                    Converter={StaticResource BoolAVisible},
                                                                    ConverterParameter=Invertir}" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pie del menú: usuario y sesión -->
                    <StackPanel Grid.Row="2" Margin="8,6,8,12">
                        <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="6,0,6,8" />

                        <!--
                            Plegado se oculta entero: unas iniciales sueltas no dicen
                            nada y sus cuarenta píxeles son los que hacen que el último
                            módulo del menú quede fuera de la pantalla.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,6"
                                    Visibility="{Binding MenuColapsado, Converter={StaticResource BoolAVisible},
                                                 ConverterParameter=Invertir}">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource MaterialDesign.Brush.Secondary}">
                                <TextBlock Text="{Binding InicialesUsuario}"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}"
                                           FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding MenuColapsado, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                                <TextBlock Text="{Binding NombreUsuario}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                <TextBlock Text="{Binding RolUsuario}"
                                           FontSize="11" Opacity="0.65" />
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="{Binding MenuColapsado,
                                                             Converter={StaticResource MenuColapsadoAAlineacion}}"
                                Command="{Binding CerrarSesionCommand}"
                                ToolTip="Cerrar la sesión actual"
                                ToolTipService.Placement="Right"
                                Margin="0,4,0,0" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LogoutVariant"
                                                         VerticalAlignment="Center" Width="19" Height="19" />
                                <TextBlock Text="Cerrar sesión"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           Visibility="{Binding MenuColapsado, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════ ÁREA PRINCIPAL ════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Border Grid.Row="0"
                        Height="{StaticResource AlturaBarraSuperior}"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding AlternarMenuCommand}"
                                    ToolTip="Contraer o expandir el menú"
                                    Width="38" Height="38">
                                <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" />
                            </Button>

                            <TextBlock Text="{Binding TituloPaginaActual}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <!-- Estado de la caja -->
                            <Border CornerRadius="14" Padding="12,5" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BrochaErrorSuave}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrochaExitoSuave}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="LockOutline" />
                                                <Setter Property="Foreground" Value="{StaticResource BrochaError}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                                        <Setter Property="Kind" Value="LockOpenVariantOutline" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrochaExito}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>

                                    <TextBlock Text="{Binding EstadoCaja}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="7,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrochaError}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrochaExito}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- La ayuda siempre a un clic, sin buscarla en el menú lateral. -->
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding NavegarCommand}"
                                    CommandParameter="manual"
                                    ToolTip="Manual de uso y tutorial guiado"
                                    Width="38" Height="38">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="20" Height="20" />
                            </Button>

                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding RecargarCommand}"
                                    ToolTip="Actualizar la información de la pantalla"
                                    Width="38" Height="38">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                            </Button>

                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding CrearRespaldoCommand}"
                                    ToolTip="Crear una copia de seguridad ahora"
                                    Width="38" Height="38">
                                <materialDesign:PackIcon Kind="DatabaseArrowDownOutline" Width="20" Height="20" />
                            </Button>

                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Width="34" Height="34" Margin="6,0,0,0"
                                          IsChecked="{Binding EsTemaOscuro, Mode=OneWay}"
                                          Command="{Binding AlternarTemaCommand}"
                                          ToolTip="Cambiar entre tema claro y oscuro">
                                <materialDesign:PackIcon Kind="WeatherSunny" Width="18" Height="18" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="WeatherNight" Width="18" Height="18" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>

                            <Border Width="1" Height="26" Margin="14,0"
                                    Background="{DynamicResource MaterialDesignDivider}" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding HoraActual}"
                                           FontWeight="SemiBold" FontSize="13"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding FechaActual}"
                                           FontSize="11" Opacity="0.62"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido del módulo activo -->
                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding PaginaActual}"
                                    Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <!-- Cada cambio de módulo entra con un desvanecido suave. -->
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- Avisos emergentes -->
                    <materialDesign:Snackbar MessageQueue="{Binding ColaMensajes}"
                                             VerticalAlignment="Bottom"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,24" />
                </Grid>

                <!-- Barra de estado -->
                <Border Grid.Row="2"
                        Height="28"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="DatabaseCheckOutline"
                                                     Width="13" Height="13"
                                                     VerticalAlignment="Center" Opacity="0.6" />
                            <TextBlock Text="Base de datos local conectada"
                                       FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />

                            <TextBlock Text="·" Opacity="0.4" Margin="10,0" VerticalAlignment="Center" />

                            <materialDesign:PackIcon Kind="WifiOff"
                                                     Width="13" Height="13"
                                                     VerticalAlignment="Center" Opacity="0.6" />
                            <TextBlock Text="Modo sin conexión"
                                       FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding NombreUsuario}"
                                       FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="·" Opacity="0.4" Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="11" Opacity="0.6" VerticalAlignment="Center">
                                <Run Text="Versión" />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
