<UserControl x:Class="Papeleria.App.Views.Dialogos.DevolucionDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:DevolucionDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="720">

    <controls:PanelFormulario Titulo="{Binding Titulo}"
                              Subtitulo="Elija cuánto vuelve de cada renglón. La factura sigue en pie."
                              Icono="KeyboardReturn"
                              MostrarLeyendaObligatorios="False"
                              AltoMaximoContenido="420">
        <StackPanel>
            <!-- Factura de la que se devuelve -->
            <Border Background="{DynamicResource MaterialDesignChipBackground}"
                    CornerRadius="8" Padding="14,11" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Venta.NumeroFactura}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource TextoTenue}" FontSize="11.5">
                            <Run Text="{Binding Venta.ClienteNombre, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding Venta.Fecha, Converter={StaticResource Fecha}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Venta.Total, Converter={StaticResource Moneda}}"
                                   HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource TextoTenue}" FontSize="11"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding Venta.TieneDevolucionesPrevias,
                                                Converter={StaticResource BoolAVisible}}">
                            <Run Text="ya devuelto" />
                            <Run Text="{Binding Venta.TotalDevuelto, Converter={StaticResource Moneda}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nada por devolver -->
            <Border Background="{StaticResource BrochaAdvertenciaSuave}"
                    CornerRadius="8" Padding="13,10" Margin="0,0,0,14"
                    Visibility="{Binding HayLineas, Converter={StaticResource BoolAVisible},
                                 ConverterParameter=Invertir}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOutline"
                                             Foreground="{StaticResource BrochaAdvertencia}"
                                             VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="De esta factura ya se devolvió todo lo que se podía."
                               Foreground="{StaticResource BrochaAdvertencia}"
                               TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Renglones devolvibles -->
            <ItemsControl ItemsSource="{Binding Lineas}"
                          Visibility="{Binding HayLineas, Converter={StaticResource BoolAVisible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" Padding="0,9"
                                BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Descripcion}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DetalleTexto}"
                                                   Style="{StaticResource TextoTenue}" FontSize="11" />

                                        <!-- Un servicio devuelto no vuelve a ninguna estantería -->
                                        <TextBlock Text="· no repone inventario"
                                                   Style="{StaticResource TextoTenue}" FontSize="11"
                                                   Margin="4,0,0,0"
                                                   Visibility="{Binding ReponeInventario,
                                                                Converter={StaticResource BoolAVisible},
                                                                ConverterParameter=Invertir}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Cantidad a devolver -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Button Style="{StaticResource BotonIconoAccion}"
                                            Command="{Binding RestarCommand}"
                                            ToolTip="Quitar uno">
                                        <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" />
                                    </Button>

                                    <Border MinWidth="52" CornerRadius="6" Padding="8,4" Margin="2,0"
                                            Background="{DynamicResource MaterialDesignChipBackground}">
                                        <TextBlock Text="{Binding Cantidad, StringFormat=N0}"
                                                   TextAlignment="Center" FontWeight="SemiBold"
                                                   FontSize="13" />
                                    </Border>

                                    <Button Style="{StaticResource BotonIconoAccion}"
                                            Command="{Binding SumarCommand}"
                                            ToolTip="Agregar uno">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                                    </Button>

                                    <Button Style="{StaticResource BotonTexto}" FontSize="11"
                                            MinWidth="0" Margin="4,0,0,0"
                                            Command="{Binding TodoCommand}"
                                            Content="Todo"
                                            ToolTip="Devolver todo lo que queda de este renglón" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           MinWidth="88" TextAlignment="Right"
                                           Text="{Binding Importe, Converter={StaticResource Moneda}}"
                                           FontWeight="SemiBold" FontSize="13" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Style="{StaticResource CampoTexto}" Margin="0,16,0,0"
                     materialDesign:HintAssist.Hint="Motivo de la devolución *"
                     materialDesign:HintAssist.HelperText="Queda registrado junto a la devolución"
                     Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="400"
                     Visibility="{Binding HayLineas, Converter={StaticResource BoolAVisible}}" />

            <!-- Total a reintegrar -->
            <Border CornerRadius="8" Padding="14,12" Margin="0,6,0,0"
                    Background="{StaticResource BrochaErrorSuave}"
                    Visibility="{Binding HayLineas, Converter={StaticResource BoolAVisible}}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Se reintegra al cliente" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{StaticResource BrochaError}" />
                        <TextBlock Style="{StaticResource TextoTenue}" FontSize="11"
                                   Foreground="{StaticResource BrochaError}">
                            <Run Text="{Binding LineasSeleccionadas, Mode=OneWay}" />
                            <Run Text="renglón(es) · sale del turno de caja abierto" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding TotalDevolverTexto}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontWeight="Bold" FontSize="21"
                               Foreground="{StaticResource BrochaError}" />
                </Grid>
            </Border>
        </StackPanel>

        <controls:PanelFormulario.Pie>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource BotonTexto}" Margin="0,0,8,0"
                        IsCancel="True" Command="{Binding CancelarCommand}" />

                <Button Style="{StaticResource BotonPrincipal}" IsDefault="True"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding PuedeGuardar}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyboardReturn" VerticalAlignment="Center" />
                        <TextBlock Text="REGISTRAR DEVOLUCIÓN" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PanelFormulario.Pie>
    </controls:PanelFormulario>
</UserControl>
