<UserControl x:Class="Papeleria.App.Views.Dialogos.CatalogoDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:CatalogoDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="500">

    <controls:PanelFormulario Titulo="{Binding Titulo}"
                              Subtitulo="Los catálogos organizan el maestro de productos."
                              Icono="ShapeOutline">
        <StackPanel>
            <TextBox Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Nombre *"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="FormatTitle"
                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="100" />

            <TextBox Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Abreviatura *"
                     materialDesign:HintAssist.HelperText="Aparece en facturas y grillas: UND, CJA, RSM…"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="FormatLetterCase"
                     Text="{Binding Abreviatura, UpdateSourceTrigger=PropertyChanged}"
                     CharacterCasing="Upper"
                     MaxLength="10"
                     Visibility="{Binding UsaAbreviatura, Converter={StaticResource BoolAVisible}}" />

            <TextBox Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Descripción"
                     Text="{Binding Descripcion}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                     VerticalContentAlignment="Top"
                     MaxLength="300" />

            <!-- Desactivar en vez de borrar: deja de ofrecerse en productos nuevos
                 pero no rompe los que ya lo usan. -->
            <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,4,0,0" />

            <TextBlock Text="Al desactivarlo deja de aparecer al crear productos, pero los que ya lo usan no se ven afectados."
                       Style="{StaticResource TextoTenue}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="30,4,0,0" />
        </StackPanel>

        <controls:PanelFormulario.Pie>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource BotonTexto}" Margin="0,0,8,0"
                        IsCancel="True" Command="{Binding CancelarCommand}" />

                <Button Style="{StaticResource BotonPrincipal}" IsDefault="True"
                        Command="{Binding GuardarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" />
                        <TextBlock Text="GUARDAR" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PanelFormulario.Pie>
    </controls:PanelFormulario>
</UserControl>
