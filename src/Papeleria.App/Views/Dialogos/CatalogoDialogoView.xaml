<UserControl x:Class="Papeleria.App.Views.Dialogos.CatalogoDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:CatalogoDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="480">

    <StackPanel Margin="24,22,24,16">
        <TextBlock Text="{Binding Titulo}"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="0,0,0,18" />

        <TextBox Style="{StaticResource CampoTexto}"
                 materialDesign:HintAssist.Hint="Nombre"
                 Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="100" />

        <TextBox Style="{StaticResource CampoTexto}"
                 materialDesign:HintAssist.Hint="Abreviatura (ej. UND, CJA)"
                 Text="{Binding Abreviatura, UpdateSourceTrigger=PropertyChanged}"
                 CharacterCasing="Upper"
                 MaxLength="10"
                 Visibility="{Binding UsaAbreviatura, Converter={StaticResource BoolAVisible}}" />

        <TextBox Style="{StaticResource CampoTexto}"
                 materialDesign:HintAssist.Hint="Descripción (opcional)"
                 Text="{Binding Descripcion}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66"
                 VerticalContentAlignment="Top"
                 MaxLength="300" />

        <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,0,0,10" />

        <Border Background="{StaticResource BrochaErrorSuave}" CornerRadius="6" Padding="12,9"
                Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BotonTexto}" Margin="0,0,8,0"
                    IsCancel="True" Command="{Binding CancelarCommand}" />
            <Button Content="Guardar" Style="{StaticResource BotonPrincipal}" IsDefault="True"
                    Command="{Binding GuardarCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
