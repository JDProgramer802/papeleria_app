<UserControl x:Class="Papeleria.App.Views.Dialogos.ClienteDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:ClienteDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="760">

    <controls:PanelFormulario Titulo="{Binding Titulo}"
                              Subtitulo="Los datos aparecen en la factura de venta."
                              Icono="AccountPlusOutline">
        <StackPanel>
            <!-- El «Consumidor final» lo usa el punto de venta y no admite ciertos cambios -->
            <Border Background="{StaticResource BrochaAdvertenciaSuave}"
                    CornerRadius="8" Padding="13,10" Margin="0,0,0,16"
                    Visibility="{Binding EsProtegido, Converter={StaticResource BoolAVisible}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="StarOutline"
                                             Foreground="{StaticResource BrochaAdvertencia}"
                                             VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="Este es el cliente por defecto del punto de venta. Puede editar sus datos, pero no desactivarlo ni eliminarlo."
                               Foreground="{StaticResource BrochaAdvertencia}"
                               TextWrapping="Wrap" MaxWidth="600" FontSize="12.5" />
                </StackPanel>
            </Border>

            <!-- ══ Identificación ═══════════════════════════════════════════ -->
            <TextBlock Text="Identificación" Style="{StaticResource TituloSeccion}" />

            <TextBox Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Nombre completo *"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="180" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Style="{StaticResource CampoSeleccion}"
                          ItemsSource="{Binding TiposDocumento}"
                          SelectedValue="{Binding TipoDocumento}"
                          SelectedValuePath="Valor" DisplayMemberPath="Descripcion"
                          materialDesign:HintAssist.Hint="Tipo de documento"
                          materialDesign:HintAssist.IsFloating="True" />

                <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Número de documento"
                         materialDesign:HintAssist.HelperText="No puede repetirse"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="CardAccountDetailsOutline"
                         Text="{Binding NumeroDocumento}" MaxLength="40" />
            </Grid>

            <!-- ══ Contacto ═════════════════════════════════════════════════ -->
            <TextBlock Text="Contacto" Style="{StaticResource TituloSeccion}" Margin="0,8,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Teléfono"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="PhoneOutline"
                         Text="{Binding Telefono}" MaxLength="40" />

                <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Correo electrónico"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="EmailOutline"
                         Text="{Binding Correo}" MaxLength="150" />

                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Ciudad"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="MapMarkerOutline"
                         Text="{Binding Ciudad}" MaxLength="100" />

                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Dirección"
                         Text="{Binding Direccion}" MaxLength="250" />
            </Grid>

            <!-- ══ Notas ════════════════════════════════════════════════════ -->
            <TextBlock Text="Notas internas" Style="{StaticResource TituloSeccion}" Margin="0,8,0,10" />

            <TextBox Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Observaciones"
                     Text="{Binding Observaciones}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                     VerticalContentAlignment="Top" MaxLength="600" />

            <CheckBox Content="Cliente activo" IsChecked="{Binding Activo}" Margin="0,4,0,0"
                      IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}" />
        </StackPanel>

        <controls:PanelFormulario.Pie>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource BotonTexto}" Margin="0,0,8,0"
                        IsCancel="True" Command="{Binding CancelarCommand}" />

                <Button Style="{StaticResource BotonPrincipal}" IsDefault="True"
                        Command="{Binding GuardarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" />
                        <TextBlock Text="GUARDAR" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PanelFormulario.Pie>
    </controls:PanelFormulario>
</UserControl>
