<UserControl x:Class="Papeleria.App.Views.Dialogos.ProductoDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:ProductoDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="940">

    <controls:PanelFormulario Titulo="{Binding Titulo}"
                              Subtitulo="{Binding TextoAyudaStock}"
                              Icono="PackageVariantClosed"
                              AltoMaximoContenido="520">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- ══ Datos del producto ═══════════════════════════════════ -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Identificación" Style="{StaticResource TituloSeccion}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox Style="{StaticResource CampoTexto}"
                                     materialDesign:HintAssist.Hint="Código interno"
                                     Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper" MaxLength="40" />
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="30" Height="30" Margin="0,6,4,0"
                                    ToolTip="Sugerir el siguiente código disponible"
                                    Command="{Binding GenerarCodigoCommand}">
                                <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <Grid Grid.Column="2">
                            <TextBox Style="{StaticResource CampoTexto}"
                                     materialDesign:HintAssist.Hint="Código de barras"
                                     Text="{Binding CodigoBarrasTexto, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="60" />
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="30" Height="30" Margin="0,6,4,0"
                                    ToolTip="Generar un código EAN-13 válido y libre"
                                    Command="{Binding GenerarCodigoBarrasCommand}">
                                <materialDesign:PackIcon Kind="BarcodeScan" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Grid>

                    <TextBox Style="{StaticResource CampoTexto}"
                             materialDesign:HintAssist.Hint="Nombre del producto"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200" />

                    <TextBox Style="{StaticResource CampoTexto}"
                             materialDesign:HintAssist.Hint="Descripción"
                             Text="{Binding Descripcion}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             VerticalContentAlignment="Top" MaxLength="600" />

                    <TextBlock Text="Clasificación" Style="{StaticResource TituloSeccion}" Margin="0,6,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Style="{StaticResource CampoSeleccion}"
                                  materialDesign:HintAssist.Hint="Categoría"
                                  ItemsSource="{Binding Categorias}"
                                  DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                  SelectedValue="{Binding CategoriaId}" />

                        <ComboBox Grid.Column="2" Style="{StaticResource CampoSeleccion}"
                                  materialDesign:HintAssist.Hint="Marca"
                                  ItemsSource="{Binding Marcas}"
                                  DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                  SelectedValue="{Binding MarcaId}" />

                        <ComboBox Grid.Column="4" Style="{StaticResource CampoSeleccion}"
                                  materialDesign:HintAssist.Hint="Unidad"
                                  ItemsSource="{Binding Unidades}"
                                  DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                  SelectedValue="{Binding UnidadMedidaId}" />
                    </Grid>

                    <TextBlock Text="Precios e impuestos" Style="{StaticResource TituloSeccion}" Margin="0,6,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource CampoNumerico}"
                                 materialDesign:HintAssist.Hint="Costo"
                                 Text="{Binding Costo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                        <TextBox Grid.Column="2" Style="{StaticResource CampoNumerico}"
                                 materialDesign:HintAssist.Hint="Precio de venta"
                                 Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                        <TextBox Grid.Column="4" Style="{StaticResource CampoNumerico}"
                                 materialDesign:HintAssist.Hint="IVA %"
                                 Text="{Binding PorcentajeIva, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                    </Grid>

                    <!-- Resumen de rentabilidad calculado en vivo -->
                    <Border Background="{DynamicResource MaterialDesignChipBackground}"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Utilidad unitaria" Style="{StaticResource EtiquetaCampo}" />
                                <TextBlock Text="{Binding UtilidadUnitaria, Converter={StaticResource Moneda}}"
                                           FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Margen" Style="{StaticResource EtiquetaCampo}" />
                                <TextBlock Text="{Binding MargenPorcentaje, Converter={StaticResource Porcentaje}}"
                                           FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio con IVA" Style="{StaticResource EtiquetaCampo}" />
                                <TextBlock Text="{Binding PrecioConIva, Converter={StaticResource Moneda}}"
                                           FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Existencias" Style="{StaticResource TituloSeccion}" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding TextoAyudaStock}" Style="{StaticResource TextoTenue}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource CampoNumerico}"
                                 materialDesign:HintAssist.Hint="Stock actual"
                                 Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 IsEnabled="{Binding PuedeEditarStock}" />

                        <TextBox Grid.Column="2" Style="{StaticResource CampoNumerico}"
                                 materialDesign:HintAssist.Hint="Stock mínimo"
                                 Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                        <TextBox Grid.Column="4" Style="{StaticResource CampoNumerico}"
                                 materialDesign:HintAssist.Hint="Stock máximo"
                                 Text="{Binding StockMaximo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}"
                                 materialDesign:HintAssist.Hint="Ubicación"
                                 Text="{Binding Ubicacion}" MaxLength="100" />

                        <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}"
                                 materialDesign:HintAssist.Hint="Observaciones"
                                 Text="{Binding Observaciones}" MaxLength="600" />
                    </Grid>

                    <CheckBox Content="Producto activo (disponible en el punto de venta)"
                              IsChecked="{Binding Activo}" />
                </StackPanel>

                <!-- ══ Imagen y código de barras ════════════════════════════ -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Imagen" Style="{StaticResource TituloSeccion}" />

                    <Border Height="190" CornerRadius="8" Margin="0,0,0,10"
                            Background="{DynamicResource MaterialDesignChipBackground}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding ImagenPath, Converter={StaticResource TextoAVisible}, ConverterParameter=Invertir}">
                                <materialDesign:PackIcon Kind="ImageOutline" Width="42" Height="42"
                                                         Opacity="0.35" HorizontalAlignment="Center" />
                                <TextBlock Text="Sin imagen" Style="{StaticResource TextoTenue}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <Image Source="{Binding ImagenPath, Converter={StaticResource RutaAImagen}}"
                                   Stretch="Uniform" Margin="8" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource BotonSecundario}"
                                Command="{Binding SeleccionarImagenCommand}"
                                ToolTip="Elegir una imagen del equipo">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImagePlus" VerticalAlignment="Center" />
                                <TextBlock Text="Cargar" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource BotonIconoAccion}"
                                Command="{Binding QuitarImagenCommand}"
                                ToolTip="Quitar la imagen"
                                Visibility="{Binding ImagenPath, Converter={StaticResource TextoAVisible}}">
                            <materialDesign:PackIcon Kind="DeleteOutline" />
                        </Button>
                    </Grid>

                    <TextBlock Text="Código de barras" Style="{StaticResource TituloSeccion}" />

                    <Border CornerRadius="8" Padding="12" Background="White"
                            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Genere o escriba un código para ver la vista previa."
                                       Style="{StaticResource TextoTenue}" FontSize="11.5"
                                       TextWrapping="Wrap" Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding ImagenCodigoBarras, Converter={StaticResource NuloAVisible}, ConverterParameter=Invertir}" />

                            <Image Source="{Binding ImagenCodigoBarras, Converter={StaticResource BytesAImagen}}"
                                   Height="70" Stretch="Uniform"
                                   Visibility="{Binding ImagenCodigoBarras, Converter={StaticResource NuloAVisible}}" />

                            <TextBlock Text="{Binding CodigoBarrasTexto}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       FontSize="11.5" Foreground="Black"
                                       Visibility="{Binding ImagenCodigoBarras, Converter={StaticResource NuloAVisible}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        <controls:PanelFormulario.Pie>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource BotonTexto}" Margin="0,0,8,0"
                        IsCancel="True" Command="{Binding CancelarCommand}" />

                <Button Style="{StaticResource BotonPrincipal}" MinWidth="180" IsDefault="True"
                        Command="{Binding GuardarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" />
                        <TextBlock Text="GUARDAR PRODUCTO" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PanelFormulario.Pie>
    </controls:PanelFormulario>
</UserControl>
