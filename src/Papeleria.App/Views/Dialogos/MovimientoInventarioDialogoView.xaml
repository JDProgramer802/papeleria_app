<UserControl x:Class="Papeleria.App.Views.Dialogos.MovimientoInventarioDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:MovimientoInventarioDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="480">

    <StackPanel Margin="24,22,24,18">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
        <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}"
                   TextWrapping="Wrap" Margin="0,4,0,14" />

        <!-- Producto afectado -->
        <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,16"
                Background="{DynamicResource MaterialDesignChipBackground}">
            <StackPanel>
                <TextBlock Text="{Binding NombreProducto}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Existencias actuales:" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding StockActual, Converter={StaticResource Cantidad}}"
                               FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                    <TextBlock Text="→" Margin="10,0" Opacity="0.5" />
                    <TextBlock Text="Resultantes:" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding StockResultante, Converter={StaticResource Cantidad}}"
                               FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Cantidad (entradas, salidas y transferencias) -->
        <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                 Style="{StaticResource CampoNumerico}"
                 materialDesign:HintAssist.Hint="Cantidad"
                 Visibility="{Binding UsaCantidad, Converter={StaticResource BoolAVisible}}" />

        <!-- Stock real contado (ajustes) -->
        <StackPanel Visibility="{Binding EsAjuste, Converter={StaticResource BoolAVisible}}">
            <TextBox Text="{Binding StockReal, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                     Style="{StaticResource CampoNumerico}"
                     FontSize="18" FontWeight="SemiBold"
                     materialDesign:HintAssist.Hint="Existencias realmente contadas" />

            <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                    Background="{DynamicResource MaterialDesignChipBackground}">
                <TextBlock FontSize="12.5">
                    <Run Text="Diferencia a registrar en el kardex:" />
                    <Run Text="{Binding DiferenciaAjuste, Converter={StaticResource Cantidad}, Mode=OneWay}"
                         FontWeight="Bold" />
                    <Run Text="unidades" />
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Costo unitario (solo entradas) -->
        <TextBox Text="{Binding CostoUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                 Style="{StaticResource CampoNumerico}"
                 materialDesign:HintAssist.Hint="Costo unitario"
                 Visibility="{Binding UsaCosto, Converter={StaticResource BoolAVisible}}" />

        <!-- Ubicaciones (solo transferencias) -->
        <Grid Visibility="{Binding EsTransferencia, Converter={StaticResource BoolAVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding UbicacionOrigen, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CampoTexto}" MaxLength="100"
                     materialDesign:HintAssist.Hint="Ubicación de origen" />

            <TextBox Grid.Column="2"
                     Text="{Binding UbicacionDestino, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CampoTexto}" MaxLength="100"
                     materialDesign:HintAssist.Hint="Ubicación de destino" />
        </Grid>

        <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource CampoTexto}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                 VerticalContentAlignment="Top" MaxLength="300"
                 materialDesign:HintAssist.Hint="Motivo del movimiento" />

        <TextBox Text="{Binding DocumentoReferencia, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource CampoTexto}" MaxLength="50"
                 materialDesign:HintAssist.Hint="Documento de referencia (opcional)"
                 Visibility="{Binding EsTransferencia, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}" />

        <Border Background="{StaticResource BrochaErrorSuave}"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}"
                       Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BotonTexto}"
                    Margin="0,0,8,0" IsCancel="True"
                    Command="{Binding CancelarCommand}" />

            <Button Content="Registrar" Style="{StaticResource BotonPrincipal}"
                    IsDefault="True" Command="{Binding GuardarCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
