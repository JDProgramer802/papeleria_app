<UserControl x:Class="Papeleria.App.Views.Dialogos.UsuarioDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:UsuarioDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="620">

    <StackPanel Margin="24,22,24,16">
        <TextBlock Text="{Binding Titulo}"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="0,0,0,18" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Grid.Column="0" Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Nombre de usuario"
                     Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                     CharacterCasing="Lower" MaxLength="50"
                     IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}" />

            <ComboBox Grid.Row="0" Grid.Column="2" Style="{StaticResource CampoSeleccion}"
                      materialDesign:HintAssist.Hint="Rol"
                      ItemsSource="{Binding Roles}"
                      DisplayMemberPath="Descripcion"
                      SelectedValuePath="Valor"
                      SelectedValue="{Binding Rol}"
                      IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}" />

            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Nombre completo"
                     Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />

            <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Correo electrónico"
                     Text="{Binding Correo}" MaxLength="150" />

            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Teléfono" Text="{Binding Telefono}" MaxLength="30" />
        </Grid>

        <!-- La contraseña solo se pide al crear; después se usa «Restablecer contraseña». -->
        <StackPanel Visibility="{Binding EsNuevo, Converter={StaticResource BoolAVisible}}">
            <Separator Style="{StaticResource SeparadorHorizontal}" />

            <TextBlock Text="Contraseña de acceso" Style="{StaticResource TituloSeccion}" />
            <TextBlock Text="Mínimo 6 caracteres, combinando letras y números."
                       Style="{StaticResource TextoTenue}" FontSize="11.5" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Contraseña"
                         Text="{Binding Contrasena, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="80" />

                <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Repetir contraseña"
                         Text="{Binding ConfirmacionContrasena, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="80" />
            </Grid>
        </StackPanel>

        <CheckBox Content="Usuario activo" IsChecked="{Binding Activo}" Margin="0,0,0,4"
                  IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}" />

        <TextBlock Text="Este es el administrador principal: no puede cambiar de rol ni desactivarse."
                   Style="{StaticResource TextoTenue}" FontSize="11.5" Margin="0,0,0,10"
                   Visibility="{Binding EsProtegido, Converter={StaticResource BoolAVisible}}" />

        <Border Background="{StaticResource BrochaErrorSuave}" CornerRadius="6" Padding="12,9"
                Margin="0,0,0,12"
                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrochaError}"
                       TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BotonTexto}" Margin="0,0,8,0"
                    IsCancel="True" Command="{Binding CancelarCommand}" />
            <Button Content="Guardar" Style="{StaticResource BotonPrincipal}" IsDefault="True"
                    Command="{Binding GuardarCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
