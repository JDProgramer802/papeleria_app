<UserControl x:Class="Papeleria.App.Views.Dialogos.UsuarioDialogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Papeleria.App.Controls"
             xmlns:vm="clr-namespace:Papeleria.App.ViewModels.Dialogos"
             d:DataContext="{d:DesignInstance vm:UsuarioDialogoVistaModelo}"
             mc:Ignorable="d"
             Width="700">

    <controls:PanelFormulario Titulo="{Binding Titulo}"
                              Subtitulo="El rol define a qué módulos puede entrar la persona."
                              Icono="AccountCogOutline">
        <StackPanel>
            <!-- El administrador principal no puede quedar sin acceso -->
            <Border Background="{StaticResource BrochaAdvertenciaSuave}"
                    CornerRadius="8" Padding="13,10" Margin="0,0,0,16"
                    Visibility="{Binding EsProtegido, Converter={StaticResource BoolAVisible}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldCrownOutline"
                                             Foreground="{StaticResource BrochaAdvertencia}"
                                             VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="Es el administrador principal del sistema: debe conservar su rol y no puede desactivarse ni eliminarse."
                               Foreground="{StaticResource BrochaAdvertencia}"
                               TextWrapping="Wrap" MaxWidth="540" FontSize="12.5" />
                </StackPanel>
            </Border>

            <!-- ══ Datos de la persona ══════════════════════════════════════ -->
            <TextBlock Text="Datos de la persona" Style="{StaticResource TituloSeccion}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Nombre completo *"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                         Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="150" />

                <ComboBox Grid.Column="2" Style="{StaticResource CampoSeleccion}"
                          ItemsSource="{Binding Roles}"
                          SelectedValue="{Binding Rol}"
                          SelectedValuePath="Valor" DisplayMemberPath="Descripcion"
                          IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}"
                          materialDesign:HintAssist.Hint="Rol *"
                          materialDesign:HintAssist.IsFloating="True" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Correo electrónico"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="EmailOutline"
                         Text="{Binding Correo}" MaxLength="150" />

                <TextBox Grid.Column="2" Style="{StaticResource CampoTexto}"
                         materialDesign:HintAssist.Hint="Teléfono"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="PhoneOutline"
                         Text="{Binding Telefono}" MaxLength="30" />
            </Grid>

            <!-- ══ Acceso ═══════════════════════════════════════════════════ -->
            <TextBlock Text="Acceso al sistema" Style="{StaticResource TituloSeccion}" Margin="0,8,0,10" />

            <TextBox Style="{StaticResource CampoTexto}"
                     materialDesign:HintAssist.Hint="Nombre de usuario *"
                     materialDesign:HintAssist.HelperText="Sin espacios, mínimo 3 caracteres. Es con lo que inicia sesión."
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="AccountCircleOutline"
                     Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                     CharacterCasing="Lower" MaxLength="50" />

            <!-- La contraseña solo se pide al crear; después se usa «Restablecer» -->
            <Grid Visibility="{Binding EsNuevo, Converter={StaticResource BoolAVisible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <PasswordBox Grid.Column="0"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Margin="0,0,0,14" VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Contraseña *"
                             materialDesign:HintAssist.HelperText="Mínimo 6 caracteres, con letras y números"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                             MaxLength="80"
                             PasswordChanged="ContrasenaCambiada" />

                <PasswordBox Grid.Column="2"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Margin="0,0,0,14" VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Repetir contraseña *"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="LockCheckOutline"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                             MaxLength="80"
                             PasswordChanged="ConfirmacionCambiada" />
            </Grid>

            <Border Background="{StaticResource BrochaInformacionSuave}"
                    CornerRadius="8" Padding="13,10" Margin="0,0,0,12"
                    Visibility="{Binding EsNuevo, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Foreground="{StaticResource BrochaInformacion}"
                                             VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="Para cambiar la contraseña de este usuario, cierre esta ventana y use «Restablecer contraseña» en el listado."
                               Foreground="{StaticResource BrochaInformacion}"
                               TextWrapping="Wrap" MaxWidth="540" FontSize="12.5" />
                </StackPanel>
            </Border>

            <CheckBox Content="Usuario activo" IsChecked="{Binding Activo}" Margin="0,4,0,0"
                      IsEnabled="{Binding EsProtegido, Converter={StaticResource InvertirBool}}" />

            <TextBlock Text="Un usuario inactivo conserva su historial pero no puede iniciar sesión."
                       Style="{StaticResource TextoTenue}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="30,4,0,0" />
        </StackPanel>

        <controls:PanelFormulario.Pie>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource BotonTexto}" Margin="0,0,8,0"
                        IsCancel="True" Command="{Binding CancelarCommand}" />

                <Button Style="{StaticResource BotonPrincipal}" IsDefault="True"
                        Command="{Binding GuardarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" />
                        <TextBlock Text="GUARDAR" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PanelFormulario.Pie>
    </controls:PanelFormulario>
</UserControl>
