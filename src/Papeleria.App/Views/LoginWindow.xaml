<Window x:Class="Papeleria.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Papeleria.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:LoginVistaModelo}"
        mc:Ignorable="d"
        Title="Iniciar sesión — PapelSoft"
        Height="700" Width="940"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Papeleria;component/Resources/Images/app.ico"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <!--
            Los campos del acceso son más altos que los del resto del programa: aquí
            solo hay dos y se escriben con el negocio abriendo, muchas veces de pie.
        -->
        <Style x:Key="CampoDeAcceso" TargetType="TextBox"
               BasedOn="{StaticResource CampoAcceso}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="14.5" />
        </Style>

        <Style x:Key="CampoDeAccesoOculto" TargetType="PasswordBox"
               BasedOn="{StaticResource CampoAccesoContrasena}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="14.5" />
        </Style>

        <Style x:Key="BotonDeAcceso" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
        </Style>

        <!-- Avisos de la tarjeta: mismo cuerpo, distinto color según lo que digan. -->
        <Style x:Key="AvisoAcceso" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13,11" />
        </Style>
    </Window.Resources>

    <!--
        La ventana va sin marco del sistema, así que el filo se lo pone ella. Es una
        línea clara de un píxel: sobre un escritorio oscuro define el contorno, y sobre
        uno claro la sombra hace el resto. Sin ella el borde se deshilacha contra el
        fondo y la ventana parece recortada a mano.
    -->
    <Border CornerRadius="18" Margin="18"
            BorderThickness="1"
            BorderBrush="#38FFFFFF"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="DesplazamientoEntrada" Y="24" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="8" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <!--
            El recorte redondeado se calcula en el código: ClipToBounds recorta al
            rectángulo, no al radio, así que las esquinas salían cuadradas y el
            degradado se desbordaba por ellas.
        -->
        <Border x:Name="Recorte" CornerRadius="17" SizeChanged="AjustarRecorte">
        <Grid MouseLeftButtonDown="ArrastrarVentana">
            <!-- ══ Fondo de marca ═══════════════════════════════════════════ -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#03153F" Offset="0" />
                    <GradientStop Color="#0B3F9E" Offset="0.52" />
                    <GradientStop Color="#0379EE" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!--
                Dos halos y nada más. Antes había tres círculos recortados por los
                bordes que se veían como un error de recorte; un resplandor suave da
                profundidad sin que se note de dónde sale.
            -->
            <Ellipse Width="700" Height="700"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-260,-220,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="560" Height="560"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-220">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1FFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- ══ Controles de ventana ═════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,12,16,0" Panel.ZIndex="2">
                <Button Style="{StaticResource BotonVentana}"
                        Foreground="White" Click="MinimizarVentana" ToolTip="Minimizar">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="15" Height="15" />
                </Button>

                <Button Style="{StaticResource BotonVentanaCerrar}"
                        Foreground="White"
                        Command="{Binding SalirCommand}" ToolTip="Salir del sistema">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                </Button>
            </StackPanel>

            <!-- ══ La tarjeta ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="20"
                    Width="440" Padding="42,38,42,34"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="14"
                                      Opacity="0.34" Color="#00122E" />
                </Border.Effect>

                <Grid>
                    <!--
                        Cinta de marca. Son los cuatro colores del logotipo —el azul del
                        nombre, el verde agua de la goma, el amarillo del lápiz y el rojo
                        del bolígrafo— en el mismo orden. Se sale del relleno para tocar
                        el borde, y las esquinas se las recorta el propio marco.
                    -->
                    <Border VerticalAlignment="Top" Height="6"
                            Margin="-42,-38,-42,0" CornerRadius="20,20,0,0"
                            Panel.ZIndex="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0379EE" Offset="0" />
                                <GradientStop Color="#0379EE" Offset="0.25" />
                                <GradientStop Color="#01CED1" Offset="0.25" />
                                <GradientStop Color="#01CED1" Offset="0.5" />
                                <GradientStop Color="#FFCF20" Offset="0.5" />
                                <GradientStop Color="#FFCF20" Offset="0.75" />
                                <GradientStop Color="#FB5A76" Offset="0.75" />
                                <GradientStop Color="#FB5A76" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ── Acceso normal ──────────────────────────────────── -->
                    <StackPanel Visibility="{Binding ExigiendoCambioContrasena, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                        <!-- El logotipo va sobre el blanco de la tarjeta, que es donde
                             está dibujado para leerse. Sin placas ni recuadros. -->
                        <Image Source="pack://application:,,,/Papeleria;component/Resources/Images/logo.png"
                               Width="196" Stretch="Uniform"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="{Binding NombreEmpresa}"
                                   HorizontalAlignment="Center"
                                   FontSize="13" Opacity="0.55"
                                   Margin="0,14,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <Separator Style="{StaticResource SeparadorHorizontal}" Margin="0,18,0,20" />

                        <TextBox x:Name="CampoUsuario"
                                 Style="{StaticResource CampoDeAcceso}"
                                 Margin="0,0,0,16"
                                 materialDesign:HintAssist.Hint="Usuario"
                                 materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                                 Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="50" />

                        <!-- Contraseña: campo enmascarado y campo visible superpuestos -->
                        <Grid Margin="0,0,0,4">
                            <PasswordBox x:Name="CampoContrasena"
                                         Style="{StaticResource CampoDeAccesoOculto}"
                                         materialDesign:HintAssist.Hint="Contraseña"
                                         materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                                         MaxLength="80"
                                         PasswordChanged="ContrasenaCambiada"
                                         KeyUp="ComprobarBloqueoMayusculas"
                                         Visibility="{Binding MostrarContrasena, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}" />

                            <TextBox x:Name="CampoContrasenaVisible"
                                     Style="{StaticResource CampoDeAcceso}"
                                     materialDesign:HintAssist.Hint="Contraseña"
                                     materialDesign:TextFieldAssist.LeadingIcon="LockOpenOutline"
                                     MaxLength="80"
                                     KeyUp="ComprobarBloqueoMayusculas"
                                     Text="{Binding Contrasena, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding MostrarContrasena, Converter={StaticResource BoolAVisible}}" />

                            <ToggleButton x:Name="BotonVerContrasena"
                                          Style="{StaticResource MaterialDesignFlatToggleButton}"
                                          Width="38" Height="38"
                                          Padding="0" Margin="0,0,6,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsTabStop="False"
                                          IsChecked="{Binding MostrarContrasena}"
                                          Checked="VisibilidadContrasenaCambiada"
                                          Unchecked="VisibilidadContrasenaCambiada"
                                          ToolTip="{Binding TextoAyudaVisibilidad}">
                                <materialDesign:PackIcon Width="20" Height="20">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="EyeOutline" />
                                            <Setter Property="Opacity" Value="0.65" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MostrarContrasena}" Value="True">
                                                    <Setter Property="Kind" Value="EyeOffOutline" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </ToggleButton>
                        </Grid>

                        <!-- Aviso de Bloq Mayús -->
                        <StackPanel Orientation="Horizontal" Margin="2,6,0,0"
                                    Visibility="{Binding BloqueoMayusculasActivo, Converter={StaticResource BoolAVisible}}">
                            <materialDesign:PackIcon Kind="AppleKeyboardCaps"
                                                     Width="15" Height="15"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource BrochaAdvertencia}" />
                            <TextBlock Text="Bloq Mayús está activado"
                                       FontSize="11.5" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrochaAdvertencia}" />
                        </StackPanel>

                        <CheckBox Content="Recordar mi usuario"
                                  IsChecked="{Binding RecordarUsuario}"
                                  Margin="0,12,0,20" />

                        <Border Style="{StaticResource AvisoAcceso}"
                                Background="{StaticResource BrochaErrorSuave}"
                                Margin="0,0,0,16"
                                Visibility="{Binding TieneError, Converter={StaticResource BoolAVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                         Foreground="{StaticResource BrochaError}"
                                                         VerticalAlignment="Top"
                                                         Margin="0,1,10,0" />
                                <TextBlock Text="{Binding MensajeError}"
                                           Foreground="{StaticResource BrochaError}"
                                           TextWrapping="Wrap"
                                           MaxWidth="280"
                                           FontSize="12.5" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource BotonDeAcceso}"
                                Command="{Binding IniciarSesionCommand}"
                                IsDefault="True">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                                    <materialDesign:PackIcon Kind="LoginVariant"
                                                             Width="21" Height="21"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />
                                    <TextBlock Text="INICIAR SESIÓN" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             IsIndeterminate="True"
                                             Width="22" Height="22"
                                             Foreground="White"
                                             Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}" />
                            </Grid>
                        </Button>

                        <!-- Credenciales de fábrica, solo el primer día -->
                        <Border Style="{StaticResource AvisoAcceso}"
                                Background="{StaticResource BrochaInformacionSuave}"
                                Margin="0,18,0,0"
                                Visibility="{Binding MostrarAvisoContrasenaPorDefecto, Converter={StaticResource BoolAVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="KeyOutline"
                                                         Foreground="{StaticResource BrochaInformacion}"
                                                         VerticalAlignment="Top"
                                                         Margin="0,1,10,0" />
                                <TextBlock Text="{Binding AvisoContrasenaPorDefecto}"
                                           Foreground="{StaticResource BrochaInformacion}"
                                           TextWrapping="Wrap"
                                           MaxWidth="280"
                                           LineHeight="17"
                                           FontSize="11.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--
                        Segundo paso, solo la primera vez: quien entra con la contraseña
                        de fábrica no llega al programa hasta ponerle una suya.
                    -->
                    <StackPanel Visibility="{Binding ExigiendoCambioContrasena, Converter={StaticResource BoolAVisible}}">
                        <Border Width="62" Height="62" CornerRadius="18"
                                HorizontalAlignment="Center"
                                Background="{StaticResource BrochaInformacionSuave}">
                            <materialDesign:PackIcon Kind="LockReset"
                                                     Width="32" Height="32"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        </Border>

                        <TextBlock Text="Póngale su contraseña"
                                   HorizontalAlignment="Center"
                                   FontSize="22" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,16,0,0" />

                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource TextoTenue}"
                                   FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                   Margin="0,8,0,22"
                                   Text="Entró con la contraseña que trae el programa de fábrica. Esa la conoce cualquiera que lo haya visto." />

                        <PasswordBox x:Name="CampoContrasenaNueva"
                                     Style="{StaticResource CampoDeAccesoOculto}"
                                     Margin="0,0,0,16"
                                     PasswordChanged="ContrasenaNuevaCambiada"
                                     materialDesign:HintAssist.Hint="Contraseña nueva"
                                     materialDesign:TextFieldAssist.LeadingIcon="LockOutline" />

                        <PasswordBox x:Name="CampoContrasenaRepetida"
                                     Style="{StaticResource CampoDeAccesoOculto}"
                                     Margin="0,0,0,8"
                                     PasswordChanged="ContrasenaRepetidaCambiada"
                                     materialDesign:HintAssist.Hint="Repítala"
                                     materialDesign:TextFieldAssist.LeadingIcon="LockCheckOutline" />

                        <TextBlock Style="{StaticResource TextoTenue}" FontSize="11.5"
                                   TextWrapping="Wrap" LineHeight="17" Margin="2,0,0,18"
                                   Text="Mínimo 6 caracteres, con letras y números. Anótela en algún lado: no hay forma de recuperarla." />

                        <Border Style="{StaticResource AvisoAcceso}"
                                Background="{StaticResource BrochaErrorSuave}"
                                Margin="0,0,0,16"
                                Visibility="{Binding MensajeError, Converter={StaticResource TextoAVisible}}">
                            <TextBlock Text="{Binding MensajeError}"
                                       Foreground="{StaticResource BrochaError}"
                                       TextWrapping="Wrap" MaxWidth="280" FontSize="12.5" />
                        </Border>

                        <Button Style="{StaticResource BotonDeAcceso}"
                                Command="{Binding ConfirmarContrasenaNuevaCommand}"
                                IsDefault="True">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}, ConverterParameter=Invertir}">
                                    <materialDesign:PackIcon Kind="LockCheckOutline"
                                                             Width="21" Height="21"
                                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="GUARDAR Y ENTRAR" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             IsIndeterminate="True" Width="22" Height="22"
                                             Foreground="White"
                                             Visibility="{Binding EstaCargando, Converter={StaticResource BoolAVisible}}" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource BotonTexto}" Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding CancelarCambioContrasenaCommand}"
                                Content="Volver" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Pie ══════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,22">
                <materialDesign:PackIcon Kind="WifiOff" Width="14" Height="14"
                                         Foreground="White" Opacity="0.6"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Foreground="White" Opacity="0.6" FontSize="11.5"
                           VerticalAlignment="Center">
                    <Run Text="Funciona sin conexión a internet" />
                    <Run Text="  ·  Versión" />
                    <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>
        </Border>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Entrada: la ventana aparece deslizándose ligeramente hacia arriba. -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35" />
                    <DoubleAnimation Storyboard.TargetName="DesplazamientoEntrada"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
