<UserControl x:Class="Papeleria.App.Impresion.ReciboTicket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dtos="clr-namespace:Papeleria.Business.Dtos;assembly=Papeleria.Business"
             d:DataContext="{d:DesignInstance dtos:VentaDetalladaDto}"
             mc:Ignorable="d"
             Background="White"
             TextElement.Foreground="Black"
             d:DesignWidth="280">

    <!--
        Tirilla de 80 mm para impresora térmica.

        Se dibuja como control de WPF y no como PDF porque esto es lo que se manda
        derecho a la impresora: el PDF sigue existiendo para guardar o enviar, pero
        cobrar no puede depender de que alguien abra un visor y busque el botón de
        imprimir con gente esperando en el mostrador.

        Todo en Consolas: en una térmica, una fuente de ancho fijo es la única forma
        de que las columnas de cifras queden alineadas.
    -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Separador" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="10,12,10,16">
        <!-- ══ Encabezado de la empresa ═════════════════════════════════════ -->
        <TextBlock Text="{Binding Empresa.Nombre}"
                   FontSize="15" FontWeight="Bold"
                   TextAlignment="Center" />

        <TextBlock Text="{Binding Empresa.LineaIdentificacion}"
                   FontSize="10" TextAlignment="Center"
                   Visibility="{Binding Empresa.LineaIdentificacion, Converter={StaticResource TextoAVisible}}" />

        <TextBlock Text="{Binding Empresa.LineaUbicacion}"
                   FontSize="10" TextAlignment="Center"
                   Visibility="{Binding Empresa.LineaUbicacion, Converter={StaticResource TextoAVisible}}" />

        <TextBlock Text="{Binding Empresa.LineaContacto}"
                   FontSize="10" TextAlignment="Center"
                   Visibility="{Binding Empresa.LineaContacto, Converter={StaticResource TextoAVisible}}" />

        <TextBlock Text="{Binding Empresa.Resolucion}"
                   FontSize="9" TextAlignment="Center" Margin="0,3,0,0"
                   Visibility="{Binding Empresa.Resolucion, Converter={StaticResource TextoAVisible}}" />

        <Border Style="{StaticResource Separador}" />

        <!-- ══ Datos de la factura ══════════════════════════════════════════ -->
        <TextBlock FontSize="13" FontWeight="Bold">
            <Run Text="FACTURA" />
            <Run Text="{Binding Venta.NumeroFactura, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Text="{Binding FechaTexto}" />
        <TextBlock Text="{Binding CajeroTexto}" />
        <TextBlock Text="{Binding ClienteTexto}" />
        <TextBlock Text="{Binding DocumentoTexto}"
                   Visibility="{Binding DocumentoTexto, Converter={StaticResource TextoAVisible}}" />

        <TextBlock Text="*** FACTURA ANULADA ***"
                   FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"
                   Visibility="{Binding EstaAnulada, Converter={StaticResource BoolAVisible}}" />

        <Border Style="{StaticResource Separador}" />

        <!-- ══ Renglones ════════════════════════════════════════════════════ -->
        <ItemsControl ItemsSource="{Binding Lineas}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,3">
                        <TextBlock Text="{Binding Descripcion}" FontWeight="Bold" />

                        <Grid>
                            <TextBlock Text="{Binding CantidadPorPrecio}" />
                            <TextBlock Text="{Binding SubtotalTexto}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Visibility="{Binding TieneDescuento, Converter={StaticResource BoolAVisible}}">
                            <TextBlock Text="{Binding DescuentoTexto}" />
                            <TextBlock Text="{Binding ValorDescuentoTexto}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Separador}" />

        <!-- ══ Totales ══════════════════════════════════════════════════════ -->
        <ItemsControl ItemsSource="{Binding Totales}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding Etiqueta}" />
                        <TextBlock Text="{Binding Valor}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,4,0,0">
            <TextBlock Text="TOTAL" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding TotalTexto}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Right" />
        </Grid>

        <TextBlock Text="{Binding FormaPagoTexto}" Margin="0,5,0,0" />

        <TextBlock Text="{Binding ReferenciaTexto}"
                   Visibility="{Binding ReferenciaTexto, Converter={StaticResource TextoAVisible}}" />

        <ItemsControl ItemsSource="{Binding Efectivo}" Margin="0,2,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding Etiqueta}" />
                        <TextBlock Text="{Binding Valor}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding ArticulosTexto}"
                   FontSize="10" TextAlignment="Center" Margin="0,8,0,0" />

        <TextBlock Text="{Binding Empresa.PieFactura}"
                   TextAlignment="Center" Margin="0,6,0,0"
                   Visibility="{Binding Empresa.PieFactura, Converter={StaticResource TextoAVisible}}" />
    </StackPanel>
</UserControl>
